    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_15712 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_15712">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>1º</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15712</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-01-29T14:19:01</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>Resolução CNJ 225/2016</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>A finalidade deste movimento é a qualificação do resultado da Sessão Restaurativa. Registro do resultado do caso após o último Encontro, frutífero com acordo e infrutífero sem acordo restaurativo, e no Pós-Encontro, frutífero com acordo cumprido ou repactuado e infrutífero com acordo não cumprido.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Realização Frutífera de Procedimentos Restaurativos</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Realizado o procedimento restaurativo de forma frutífera</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_15713 -->

