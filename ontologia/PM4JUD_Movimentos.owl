        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1013</stj:codigoMovimentoTPU>
