        <stj:dispositivoLegalMovimento>L 7.210/1984</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Registra a decisão que transfere a execução da pena a outro juízo territorialmente distinto.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Transferência da Execução da Pena</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Autorizada a Transferência do local da Execução da Pena</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


