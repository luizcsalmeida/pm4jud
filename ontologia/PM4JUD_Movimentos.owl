    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_446 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_446">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>14</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">446</stj:codigoMovimentoTPU>
        <stj:complementoMovimento>Identificador - parte;</stj:complementoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>12.016/2009</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Semelhante ao movimento Julgada improcedente a ação. Pode incluir pedidos não conhecidos.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Segurança</stj:nomeMovimentoTPU>
