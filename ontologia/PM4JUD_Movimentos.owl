    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_866 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_866">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">866</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Guarda intermediária pelo arquivo do Juízo. Processo arquivado definitivamente, em geral após Baixa Definitiva, e que poderá ser eliminado no futuro.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Guarda Intermediária</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Arquivo em Guarda Intermediária</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_867 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_867">
