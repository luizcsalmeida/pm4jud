    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_818 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_818">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>310, III e 321 (CPP); 270 (CPPM)</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">818</stj:codigoMovimentoTPU>
        <stj:complementoMovimento>Identificador - Nome do réu;</stj:complementoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPP; CPPM</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Registra a ordem de liberdade provisória do acusado. Não é aplicável em execução penal.</stj:glossarioMovimento>
