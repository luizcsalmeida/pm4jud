        <stj:artigoLegalMovimento>267, VI</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">461</stj:codigoMovimentoTPU>
        <stj:dataAlteracaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-14T15:04:11</stj:dataAlteracaoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>CPC, Art. 267. Extingue-se o processo, sem resolução de mérito:[...] Vl - quando não concorrer qualquer das condições da ação, como a possibilidade jurídica, a legitimidade das partes e o interesse processual;</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Ausência das condições da ação</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Extinto o processo por ausência das condições da ação</stj:tipoMovimento>
