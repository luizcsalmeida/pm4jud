        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>267, IX</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">464</stj:codigoMovimentoTPU>
