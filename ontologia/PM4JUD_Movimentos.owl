        <stj:glossarioMovimento>Registra a solução do processo NO JUÍZO ORIGINÁRIO. Tratando-se de juízo recursal, registrar em Conhecido o recurso de parte e provido em parte.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Procedência em Parte</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Julgado procedente em parte o pedido</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_230 -->

