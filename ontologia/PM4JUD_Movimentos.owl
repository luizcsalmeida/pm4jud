        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPP</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Indica a decisão que recebeu a queixa. Deve se referir à data em que a decisão foi proferida (CP 117 I), para automatizar a contagem do prazo da prescrição.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Queixa</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Recebida a queixa contra #{nome_da_parte}</stj:tipoMovimento>
