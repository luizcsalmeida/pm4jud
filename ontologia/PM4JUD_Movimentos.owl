    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_1053 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_1053">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1053</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Registra a destinação da totalidade dos bens apreendidos no processo. Em caso de destinação parcial, utilizar Destinação Parcial de Bens Apreendidos.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Destinação</stj:nomeMovimentoTPU>
