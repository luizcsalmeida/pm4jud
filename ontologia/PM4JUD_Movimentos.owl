        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:nomeMovimentoTPU>Extinção</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Extinto o processo sem resolução do mérito por</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_457 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_457">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>267, II</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">457</stj:codigoMovimentoTPU>
        <stj:dataAlteracaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-14T15:07:03</stj:dataAlteracaoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>CPC, Art. 267. Extingue-se o processo, sem resolução de mérito: II - quando ficar parado durante mais de 1 (um) ano por negligência das partes;</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Paralisação por negligência das partes</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Extinto o processo por negligência das partes</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_458 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_458">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>485, III</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">458</stj:codigoMovimentoTPU>
        <stj:dataAlteracaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-14T15:03:03</stj:dataAlteracaoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>CPC, Art. 485.  O juiz não resolverá o mérito quando: [...] III - por não promover os atos e as diligências que lhe incumbir, o autor abandonar a causa por mais de 30 (trinta) dias</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Abandono da causa</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Extinto o processo por abandono da causa pelo autor</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_459 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_459">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>267, IV; 618, I a III.</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">459</stj:codigoMovimentoTPU>
        <stj:dataAlteracaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-14T15:05:56</stj:dataAlteracaoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>CPC, Art. 267. Extingue-se o processo, sem resolução de mérito: IV - quando se verificar a ausência de pressupostos de constituição e de desenvolvimento válido e regular do processo; CPC, Art. 618. É nula a execução: I - se o título executivo não for líquido, certo e exigível (art. 586); I - se o título executivo extrajudicial não corresponder a obrigação certa, líquida e exigível (art. 586); (Redação dada pela Lei nº 11.382, de 2006). II - se o devedor não for regularmente citado; III - se instaurada antes de se verificar a condição ou de ocorrido o termo, nos casos do art. 572.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Ausência de pressupostos processuais</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Extinto o processo por ausência de pressupostos processuais</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_460 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_460">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>267, V</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">460</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>CPC, Art. 267. Extingue-se o processo, sem resolução de mérito: V - quando o juiz acolher a alegação de perempção, litispendência ou de coisa julgada;</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Perempção, litispendência ou coisa julgada</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Extinto o processo por Perempção, litispendência ou coisa julgada</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_461 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_461">
