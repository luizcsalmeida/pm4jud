    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_394 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_394">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">394</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Recurso recebido nos efeitos devolutivo e suspensivo. Se a suspensão for outorgada em decisão apartada, registrar essa nova decisão em Decisão\Concessão de efeito suspensivo\Recurso. O recurso recebido será identificado pelo movimento anterior.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Com efeito suspensivo</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Recebido o recurso Com efeito suspensivo</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_399 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_399">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>384; 78</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">399</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPP; CPPM</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>CPP Art. 384. Decisão que rejeita aditamento à denúncia. CPPM Art. 78. A denúncia não será recebida pelo juiz: a) se não contiver os requisitos expressos no artigo anterior; b) se o fato narrado não constituir evidentemente crime da competência da Justiça Militar; c) se já estiver extinta a punibilidade; d) se fôr manifesta a incompetência do juiz ou a ilegitimidade do acusador.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Aditamento da denúncia</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Rejeitado o aditamento à denúncia</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_400 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_400">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>CPP, art. 384. Decisão que rejeita aditamento à queixa.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Aditamento da queixa</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Rejeitado o aditamento à queixa</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_402 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_402">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>43; 78</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">402</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPP; CPPM</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Decisão com efeito extintivo do processo. Deve ser registrada a situação neste item, sem recorrer aos itens de Julgamento. CPP Art. 43. A denúncia ou queixa será rejeitada quando: I - o fato narrado evidentemente não constituir crime; II - já estiver extinta a punibilidade, pela prescrição ou outra causa; III - for manifesta a ilegitimidade da parte ou faltar condição exigida pela lei para o exercício da ação penal. Parágrafo único. Nos casos do no III, a rejeição da denúncia ou queixa não obstará ao exercício da ação penal, desde que promovida por parte legítima ou satisfeita a condição. CPPM CPPM Art. 78. A denúncia não será recebida pelo juiz: a) se não contiver os requisitos expressos no artigo anterior; b) se o fato narrado não constituir evidentemente crime da competência da Justiça Militar; c) se já estiver extinta a punibilidade; d) se fôr manifesta a incompetência do juiz ou a ilegitimidade do acusador.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Denúncia</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Rejeitada a denúncia</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_404 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_404">
