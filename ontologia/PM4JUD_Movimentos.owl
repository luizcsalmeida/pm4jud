        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12143</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-05-05T00:00:00</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Indica a mudança de assunto processual</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Mudança de Assunto Processual</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Alterado o assunto processual</stj:tipoMovimento>
