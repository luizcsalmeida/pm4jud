    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_12028 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_12028">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>art. 84, parágrafo único</stj:artigoLegalMovimento>
