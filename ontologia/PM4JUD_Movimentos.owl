        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Guarda Definitiva pelo arquivo do Juízo. Processo arquivado definitivamente e que não poderá ser eliminado (ex. processos de guarda histórica).</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Guarda Permanente</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Arquivo em Guarda permanente</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_869 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_869">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">869</stj:codigoMovimentoTPU>
        <stj:complementoMovimento>Identificador - &quot;interessado&quot;;</stj:complementoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Para a hipótese em que os autos seriam eliminados e a parte fez uso da faculdade de permanecer com o processo definitivamente.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Entrega definitiva dos autos</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Entrega Definitiva dos Autos a #{nome_da_parte}</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_870 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_870">
