    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_219 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_219">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">219</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Registra a solução do processo NO JUÍZO ORIGINÁRIO. Tratando-se de juízo recursal, registrar em Conhecido o recurso de parte e provido.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Procedência</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Julgado procedente o pedido</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_22 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_22">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>É o registro da baixa definitiva do processo. Em alguns tribunais a baixa definitiva é registrada pela secretaria, em outros, pela distribuição. Também usado pelos tribunais quando devolve o processo ao primeiro grau após julgamento de recurso.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Baixa Definitiva</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Baixa Definitiva</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_220 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_220">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">220</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Registra a solução do processo NO JUÍZO ORIGINÁRIO. Inclui a hipótese do art. 285-A do CPC. Tratando-se de juízo recursal, registrar em Conhecido o recurso de parte e não-provido. Casos de extinção sem resolução de mérito devem ser registrados no grupo próprio e não aqui.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Improcedência</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Julgado improcedente o pedido</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_221 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_221">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
