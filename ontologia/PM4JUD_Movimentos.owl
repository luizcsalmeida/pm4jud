    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_12144">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>111</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12144</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-05-05T00:00:00</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>Lei de Execução Penal</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Indica a sentença proferida pelo juiz da execução penal que determina a soma ou unificação das penas, nos termos do art. 111 da LEP.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Unificação e Soma de Penas</stj:nomeMovimentoTPU>
