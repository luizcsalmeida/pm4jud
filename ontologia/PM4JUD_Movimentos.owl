    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_12734 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_12734">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>28-A, § 10º</stj:artigoLegalMovimento>
