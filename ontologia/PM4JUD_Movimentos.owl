    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_15714 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_15714">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>1º</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15714</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-01-29T14:33:14</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>Resolução CNJ 225/2016</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>A finalidade deste movimento é o registro que não gere subnotificação do trabalho dispendido para a construção de cada intervenção com as metodologias restaurativas, quantificando em cada fase o tempo e a dedicação despendidos. Este movimento além do registro de todas as Sessões Restaurativas ocorridas em cada processo, identifica a fase, Pré-Encontro, Encontro e Pós-Encontro, situação da sessão, se realizada ou não, a metodologia, Círculos de Construção de Paz, Conferências Vítima-Ofensor-Comunidade etc., e a data e hora em que foi realizada a Sessão.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Sessão Restaurativa - Pré-Encontro</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Sessão restaurativa do tipo pré-encontro usando o método/tecnia #{metodo_tecnica_justica_restaurativa} #{situacao_da_audiencia} em #{data_hora}</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


