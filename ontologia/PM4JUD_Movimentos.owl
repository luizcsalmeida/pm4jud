    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_12437 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_12437">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>253,§ único, II,d</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12437</stj:codigoMovimentoTPU>
        <stj:dataAlteracaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-07-31T12:53:18</stj:dataAlteracaoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-09T00:00:00</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>RISTJ</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Art. 253. O agravo interposto de decisão que não admitiu o recurso especial obedecerá, no Tribunal de origem, às normas da legislação processual vigente. Parágrafo único. Distribuído o agravo e ouvido, se necessário, o Ministério Público no prazo de cinco dias, o relator poderá: d) determinar sua autuação como recurso especial quando não verificada qualquer das hipóteses previstas nas alíneas b e c, observando-se, daí em diante, o procedimento relativo a esse recurso</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Conhecimento para determinar sua autuação como Recurso Especial</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Conheço do agravo de #{nome_da_parte} para determinar sua autuação como Recurso Especial</stj:tipoMovimento>
