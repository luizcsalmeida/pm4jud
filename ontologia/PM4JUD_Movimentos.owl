        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-10-19T00:00:00</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CP</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>CP Art. 107 - Extingue-se a punibilidade: IV - pela (...) decadência ou perempção;</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Decadência ou perempção</stj:nomeMovimentoTPU>
