        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:47</stj:dataPublicacaoMovimento>
        <stj:glossarioMovimento>Indica a decisão que admite o recurso de terceiro nível. Outros recursos devem ser registrados em Decisão ou Despacho;Recebimento ou Decisão ou Despacho;Não-Recebimento.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Admissão</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Decisão ou Despacho Admissão</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


