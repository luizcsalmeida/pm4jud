        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Registra as hipóteses de perda de objeto, de reconhecimento dos efeitos de recurso extraordinário com repercussão geral, etc.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Recurso prejudicado</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Prejudicado o recurso #{nome_da_parte}</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_235 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_235">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
