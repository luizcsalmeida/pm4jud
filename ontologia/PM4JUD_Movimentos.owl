    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_12766 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_12766">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>1.030, II</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12766</stj:codigoMovimentoTPU>
        <stj:dataAlteracaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-12T17:06:15</stj:dataAlteracaoMovimento>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-15T00:00:00</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Art. 1.030. Recebida a petição do recurso pela secretaria do tribunal, o recorrido será intimado para apresentar contrarrazões no prazo de 15 (quinze) dias, findo o qual os autos serão conclusos ao presidente ou ao vice-presidente do tribunal recorrido, que deverá: (...) II - encaminhar o processo ao órgão julgador para realização do juízo de retratação, se o acórdão recorrido divergir do entendimento do Supremo Tribunal Federal ou do Superior Tribunal de Justiça exarado, conforme o caso, nos regimes de repercussão geral ou de recursos repetitivos; (...).</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Por Divergência de Entendimento com o STF</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Determinado o encaminhamento dos autos para juízo de retratação em razão de divergência com o #{numero_tema_RG}</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/movimentos#Movimento_12768 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/movimentos#Movimento_12768">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <stj:artigoLegalMovimento>1041</stj:artigoLegalMovimento>
        <stj:codigoMovimentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12768</stj:codigoMovimentoTPU>
        <stj:dataPublicacaoMovimento rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-15T00:00:00</stj:dataPublicacaoMovimento>
        <stj:dispositivoLegalMovimento>CPC</stj:dispositivoLegalMovimento>
        <stj:glossarioMovimento>Art. 1.041. Mantido o acórdão divergente pelo tribunal de origem, o recurso especial ou extraordinário será remetido ao respectivo tribunal superior, na forma do art. 1.036, § 1º.</stj:glossarioMovimento>
        <stj:nomeMovimentoTPU>Manutenção de Acórdão</stj:nomeMovimentoTPU>
        <stj:tipoMovimento>Mantido o Acórdão Divergente</stj:tipoMovimento>
        <stj:visibilidadeExterna>Sim</stj:visibilidadeExterna>
    </owl:NamedIndividual>
    


