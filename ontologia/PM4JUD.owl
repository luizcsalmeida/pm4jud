        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_12475"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_443"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_447"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_451"/>
        <temAtividadeConsequente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_92"/>
        <codigoRegra>C6</codigoRegra>
