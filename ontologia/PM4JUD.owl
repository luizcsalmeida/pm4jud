        <temFundamentoNoArtigo>Meta Nacional CNJ 4a — 2025</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">Meta 4a CNJ 2025</rdfs:comment>
        <rdfs:label xml:lang="pt">C9 — Meta 4a CNJ: julgar crimes contra administração pública</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_I -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_I">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraTemporal"/>
        <temFundamentoNoArtigo>art. 110, I do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Prazo de 10 dias para atos administrativos e
decisões interlocutórias após conclusão dos autos (TPU 51 → TPU 11383).
Verificável no Nível 1 via DATAJUD. Formalizado como C10 no P5 (LTLf).</rdfs:comment>
        <rdfs:label xml:lang="pt">Prazo de 10 dias — atos ordinatórios — art. 110, I do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_III -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_III">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraTemporal"/>
        <temFundamentoNoArtigo>art. 110, III do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Prazo de 30 dias para visto do relator após conclusão
dos autos (TPU 51 → TPU 14093). No contexto colegiado, corresponde ao intervalo entre
conclusos e a elaboração do RELATÓRIO E VOTO. Verificável no Nível 1 (TPU 51→14093)
e no Nível 2 (SAGWeb: Conclusão para decisão → 10: Criação RELATÓRIO E VOTO).
Formalizado como C11 no P5 (LTLf).</rdfs:comment>
        <rdfs:label xml:lang="pt">Prazo de 30 dias — visto do relator — art. 110, III do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art123 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art123">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 123 do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">O acórdão conterá ementa da questão de direito decidida.
Formaliza a obrigação de existência do documento EMENTA/ACÓRDÃO após toda sessão de
julgamento. Verificável no Nível 2 pela presença da atividade SAGWeb
&quot;10: Criação de documento EMENTA ACÓRDÃO&quot; após TPU 3001 no log complementado.</rdfs:comment>
        <rdfs:label xml:lang="pt">Conteúdo obrigatório do acórdão — art. 123 do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art177_II -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art177_II">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDePrioridade"/>
        <temFundamentoNoArtigo>art. 177, II do RISTJ</temFundamentoNoArtigo>
        <rdfs:label xml:lang="pt">Prioridade de pauta — art. 177, II do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art179 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art179">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraTemporal"/>
        <temFundamentoNoArtigo>art. 179 do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Prazo de 30 dias para elaboração e entrega do acórdão
após a sessão de julgamento (TPU 3001 → TPU 11383 que antecede a publicação do acórdão).
Verificável no Nível 1 via DATAJUD (TPU 3001 → TPU 11383).
Formalizado como C13 no P5 (LTLf).</rdfs:comment>
        <rdfs:label xml:lang="pt">Prazo de 30 dias para elaboração do acórdão — art. 179 do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art180 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art180">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 180 do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">O acórdão deve ser assinado por todos os Ministros
que participaram do julgamento. Verificável no Nível 2 pela presença das atividades SAGWeb
de assinatura eletrônica do ministro (G5b) após elaboração da EMENTA/ACÓRDÃO no log
complementado pelo P3.</rdfs:comment>
        <rdfs:label xml:lang="pt">Assinatura do acórdão pelos participantes — art. 180 do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art202 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art202">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 202 do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Instruído o processo e ouvido o MP em 2 dias,
coloca em mesa na primeira sessão. Formaliza prazo máximo no modelo DES.</rdfs:comment>
        <rdfs:label xml:lang="pt">Colocação em mesa — art. 202 do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art203_II -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art203_II">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 203, II do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Tribunal pode expedir HC de ofício (mov. TPU 12475).</rdfs:comment>
        <rdfs:label xml:lang="pt">Concessão de ofício — art. 203, II do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XIX -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XIX">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 34, XIX do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Relator pode julgar recursos quando a orientação
do julgamento estiver pacificada em súmula ou jurisprudência dominante do STJ.
Complementa o art. 34, XX para a via monocrática.</rdfs:comment>
        <rdfs:label xml:lang="pt">Julgamento monocrático por jurisprudência — art. 34, XIX do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XVIII -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XVIII">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 34, XVIII do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Relator pode negar seguimento a pedido ou recurso
manifestamente inadmissível, improcedente, prejudicado ou em confronto com a
jurisprudência dominante do Tribunal. Fundamenta a via monocrática via DESPACHO/DECISÃO.</rdfs:comment>
        <rdfs:label xml:lang="pt">Negar seguimento — art. 34, XVIII do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XX -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XX">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 34, XX do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Relator pode decidir monocraticamente quando matéria
coberta por jurisprudência consolidada (~77% decisões STJ são monocráticas).</rdfs:comment>
        <rdfs:label xml:lang="pt">Decisão monocrática — art. 34, XX do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par1 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par1">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 38, §1º do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Em HC, o relator pode conceder a medida liminar
monocraticamente antes da sessão de julgamento. Corresponde ao TPU 339 (liminar deferida)
lançado via DESPACHO/DECISÃO do gabinete (SAGWeb 10→20→40). Verificável no Nível 1
pela presença do mov. TPU 339 no traço.</rdfs:comment>
        <rdfs:label xml:lang="pt">Concessão de liminar em HC — art. 38, §1º do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par2 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par2">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 38, §2º do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">Em HC, o relator pode denegar a medida liminar
monocraticamente. Corresponde ao TPU 792 (não concedida a medida liminar) lançado via
DESPACHO/DECISÃO do gabinete. Verificável no Nível 1 pela presença do mov. TPU 792.</rdfs:comment>
        <rdfs:label xml:lang="pt">Denegação de liminar em HC — art. 38, §2º do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art91_I -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art91_I">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDePrioridade"/>
        <temFundamentoNoArtigo>art. 91, I do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">HC tem julgamento prioritário independente de pauta.</rdfs:comment>
        <rdfs:label xml:lang="pt">Prioridade de julgamento — art. 91, I do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art94 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art94">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 94 do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">O relator provê, dirige e ordena o processo.
No contexto do julgamento colegiado, formaliza a obrigação de elaborar o RELATÓRIO E VOTO
antes da inclusão em pauta. Verificável no Nível 2 pela presença da atividade SAGWeb
&quot;10: Criação de documento RELATÓRIO E VOTO&quot; no log complementado pelo P3.</rdfs:comment>
        <rdfs:label xml:lang="pt">Competências do relator — art. 94 do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Regra_RISTJ_Art95 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art95">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <temFundamentoNoArtigo>art. 95 do RISTJ</temFundamentoNoArtigo>
        <rdfs:comment xml:lang="pt">O relator apresentará o relatório e submeterá
o processo ao julgamento na sessão. Formaliza que TPU 3002 (inclusão em mesa) deve
ser seguido de TPU 239/3001 (julgamento). Verificável no Nível 1 via DATAJUD.</rdfs:comment>
        <rdfs:label xml:lang="pt">Apresentação em sessão pelo relator — art. 95 do RISTJ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#Tributario -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#Tributario">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#Especialidade"/>
        <rdfs:label xml:lang="pt">Tributário</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/classes#Classe_1013 -->

    <rdf:Description rdf:about="http://www.pucpr.br/pm4jud/classes#Classe_1013">
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_I"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_III"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art177_II"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XVIII"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par1"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par2"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art91_I"/>
    </rdf:Description>
    


    <!-- http://www.pucpr.br/pm4jud/classes#Classe_1064 -->

    <rdf:Description rdf:about="http://www.pucpr.br/pm4jud/classes#Classe_1064">
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_I"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_III"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art177_II"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XVIII"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par1"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par2"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art91_I"/>
    </rdf:Description>
    


    <!-- http://www.pucpr.br/pm4jud/classes#Classe_15224 -->

    <rdf:Description rdf:about="http://www.pucpr.br/pm4jud/classes#Classe_15224">
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_I"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art110_III"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art177_II"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art34_XVIII"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par1"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art38_Par2"/>
        <sujeitoA rdf:resource="http://www.pucpr.br/pm4jud#Regra_RISTJ_Art91_I"/>
    </rdf:Description>
    


    <!-- http://www.pucpr.br/pm4jud/classes#Classe_1720 -->

