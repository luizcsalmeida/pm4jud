        <codigoRegra>C9</codigoRegra>
        <indicadorAlvo>eta_meta4a</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nivelVerificacao>
        <padraoLTLf>response_with_deadline</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</prazoMaxDiasUteis>
