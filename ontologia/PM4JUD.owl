<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.pucpr.br/pm4jud#"
     xml:base="http://www.pucpr.br/pm4jud"
     xmlns:ass="http://www.pucpr.br/pm4jud/assuntos#"
     xmlns:cls="http://www.pucpr.br/pm4jud/classes#"
     xmlns:doc="http://www.pucpr.br/pm4jud/documentos#"
     xmlns:mni="http://www.cnj.jus.br/intercomunicacao-2.2.2#"
     xmlns:mov="http://www.pucpr.br/pm4jud/movimentos#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:stj="http://www.stj.jus.br/mni/intercomunicacao#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:pm4jud="http://www.pucpr.br/pm4jud#">
    <owl:Ontology rdf:about="http://www.pucpr.br/pm4jud">
        <owl:imports rdf:resource="http://www.pucpr.br/pm4jud/assuntos"/>
        <owl:imports rdf:resource="http://www.pucpr.br/pm4jud/classes"/>
        <owl:imports rdf:resource="http://www.pucpr.br/pm4jud/documentos"/>
        <owl:imports rdf:resource="http://www.pucpr.br/pm4jud/movimentos"/>
        <rdfs:comment xml:lang="pt">Adaptação do PM4SOS (Ferronato, 2022) para o STJ.
PPGIa/PUCPR — Luiz Claudio Soares de Almeida.
Orientador: Prof. Dr. Edson Emílio Scalabrin. TPU/CNJ: 09/04/2026.</rdfs:comment>
        <rdfs:label xml:lang="pt">PM4JUD — Framework de Mineração de Processos Judiciais</rdfs:label>
        <rdfs:label xml:lang="en">PM4JUD — Process Mining Framework for Judicial Decision-Making</rdfs:label>
        <owl:versionInfo>2.0.0-2026-05</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.pucpr.br/pm4jud#aplicaSeAAssuntoProcessual -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#aplicaSeAAssuntoProcessual">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:comment xml:lang="pt">Restringe a regra a um Assunto
Processual TPU específico. Usado em C9 (crimes contra a
administração pública). Ligado a indivíduos PM4JUD_Assuntos.</rdfs:comment>
        <rdfs:label xml:lang="pt">aplica-se ao Assunto Processual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#aplicaSeAClasseProcessual -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#aplicaSeAClasseProcessual">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:comment xml:lang="pt">Restringe a regra a uma Classe
Processual TPU específica. Ausência = aplica-se a todas.
Ligado a indivíduos do módulo PM4JUD_Classes.</rdfs:comment>
        <rdfs:label xml:lang="pt">aplica-se à Classe Processual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#impõePrioridade -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#impõePrioridade">
        <rdfs:subPropertyOf rdf:resource="http://www.pucpr.br/pm4jud#sujeitoA"/>
        <rdfs:label xml:lang="pt">impõe prioridade sobre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#incideSobreClasseTPU -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#incideSobreClasseTPU">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#MetaNacionalCNJ"/>
        <rdfs:label xml:lang="pt">incide sobre classe TPU</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#movimentoTipicoHC -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#movimentoTipicoHC">
        <rdfs:label xml:lang="pt">movimento típico de Habeas Corpus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#pertenceAEspecialidade -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#pertenceAEspecialidade">
        <rdfs:range rdf:resource="http://www.pucpr.br/pm4jud#Especialidade"/>
        <rdfs:label xml:lang="pt">pertence à especialidade</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#sujeitoA -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#sujeitoA">
        <rdfs:range rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <rdfs:label xml:lang="pt">sujeito a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temAssunto -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#temAssunto">
        <rdfs:domain rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#ProcessoJudicial"/>
        <rdfs:label xml:lang="pt">tem assunto</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temAtividadeAntecedente -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#temAtividadeAntecedente">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <rdfs:comment xml:lang="pt">Movimento Processual A no padrão
Declare &quot;A → B&quot;. Ligado a indivíduos do módulo PM4JUD_Movimentos.</rdfs:comment>
        <rdfs:label xml:lang="pt">tem Movimento Processual antecedente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temAtividadeConsequente -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#temAtividadeConsequente">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#MovimentoProcessual"/>
        <rdfs:comment xml:lang="pt">Movimento Processual B no padrão
Declare &quot;A → B&quot;. Ligado a indivíduos do módulo PM4JUD_Movimentos.</rdfs:comment>
        <rdfs:label xml:lang="pt">tem Movimento Processual consequente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temClasseProcessual -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#temClasseProcessual">
        <rdfs:domain rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#CabecalhoProcesso"/>
        <rdfs:label xml:lang="pt">tem classe processual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temDocumento -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#temDocumento">
        <rdfs:domain rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#ProcessoJudicial"/>
        <rdfs:label xml:lang="pt">tem documento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temMovimento -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#temMovimento">
        <rdfs:domain rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#ProcessoJudicial"/>
        <rdfs:label xml:lang="pt">tem movimento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temPapelResultadoHC -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#temPapelResultadoHC">
        <rdfs:label xml:lang="pt">tem papel de resultado em Habeas Corpus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.pucpr.br/pm4jud#vinculadoAOrgao -->

    <owl:ObjectProperty rdf:about="http://www.pucpr.br/pm4jud#vinculadoAOrgao">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#MagistradoAtuante"/>
        <rdfs:range rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#OrgaoJulgador"/>
        <rdfs:label xml:lang="pt">vinculado ao órgão julgador</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.pucpr.br/pm4jud#codigoRegra -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#codigoRegra">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Identificador único: C1–C9.
Usado no cabeçalho dos relatórios gerados pelo P8 (STAT).</rdfs:comment>
        <rdfs:label xml:lang="pt">código da regra</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#indicadorAlvo -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#indicadorAlvo">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Indicador do protocolo experimental
afetado. Valores: T_bar | G | kappa | eta_meta1 | eta_meta2 |
eta_meta4a.</rdfs:comment>
        <rdfs:label xml:lang="pt">indicador alvo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#nivelVerificacao -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#nivelVerificacao">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">1 = verificável com dados públicos
DATAJUD. 2 = requer eventos internos: dados reais do SAGWeb
(Fase 2) ou [SIM-ASSESSOR] do Complement (Fase 1).</rdfs:comment>
        <rdfs:label xml:lang="pt">nível de verificação</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#padraoLTLf -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#padraoLTLf">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Padrão Declare instanciado via pm4py
pelo P5. Valores: response | precedence | chain_response |
existence | absence | cond_resource | aggregate_count |
response_with_deadline.</rdfs:comment>
        <rdfs:label xml:lang="pt">padrão LTLf Declare</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#prazoMaxDiasUteis -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#prazoMaxDiasUteis">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Prazo para regras temporais.
Valor -1 indica ausência de prazo definido.</rdfs:comment>
        <rdfs:label xml:lang="pt">prazo máximo em dias úteis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#regraAtiva -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#regraAtiva">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="pt">true = verificada pelo P5 (padrão).
false = suspensa sem remover axiomas. As queries SPARQL
filtram por regraAtiva = true.</rdfs:comment>
        <rdfs:label xml:lang="pt">regra ativa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temAtividadeSAGWebAntecedente -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#temAtividadeSAGWebAntecedente">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Nome canônico da Atividade Judicial SAGWeb antecedente
na regra Declare. Usado exclusivamente em regras de Nível 2, que requerem eventos
internos do SAGWeb (reais na Fase 2 ou simulados [SIM-ASSESSOR] na Fase 1).
O valor deve corresponder exatamente ao campo concept:name gerado pelo PM4JUD-COMPLEMENT (P3).</rdfs:comment>
        <rdfs:label xml:lang="pt">tem Atividade Judicial SAGWeb antecedente</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temAtividadeSAGWebConsequente -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#temAtividadeSAGWebConsequente">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Nome canônico da Atividade Judicial SAGWeb consequente
na regra Declare. Mesmo critério de correspondência que temAtividadeSAGWebAntecedente.</rdfs:comment>
        <rdfs:label xml:lang="pt">tem Atividade Judicial SAGWeb consequente</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temFundamentoNoArtigo -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#temFundamentoNoArtigo">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">tem fundamento no artigo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#temIndicador -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#temIndicador">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#MetaNacionalCNJ"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">tem indicador</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.pucpr.br/pm4jud#tipoViolacao -->

    <owl:DatatypeProperty rdf:about="http://www.pucpr.br/pm4jud#tipoViolacao">
        <rdfs:domain rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">hard = restrição rígida: solução
descartada no P7 quando violada; SA aciona reparo.
soft = penaliza função fitness sem descartar.</rdfs:comment>
        <rdfs:label xml:lang="pt">tipo de violação</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.pucpr.br/pm4jud#AutoridadeCoatora -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#AutoridadeCoatora">
        <rdfs:subClassOf rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#Parte"/>
        <rdfs:comment xml:lang="pt">Autoridade apontada como responsável pela
coação ilegal ou ameaça à liberdade de locomoção do paciente.</rdfs:comment>
        <rdfs:label xml:lang="pt">Autoridade Coatora</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#Especialidade -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#Especialidade">
        <rdfs:comment xml:lang="pt">Especialidade da matéria: Criminal, Cível,
Tributário ou Previdenciário. Inferida via pertenceAEspecialidade.</rdfs:comment>
        <rdfs:label xml:lang="pt">Especialidade Processual</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#Impetrante -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#Impetrante">
        <rdfs:subClassOf rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#Parte"/>
        <rdfs:comment xml:lang="pt">Quem impetrou o writ de Habeas Corpus.
Pode ser o próprio paciente, advogado ou qualquer pessoa (CPP art. 654).</rdfs:comment>
        <rdfs:label xml:lang="pt">Impetrante</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#MagistradoAtuante -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#MagistradoAtuante">
        <rdfs:comment xml:lang="pt">Magistrado com atuação formal no processo
judicial, conforme o campo magistradoAtuante do CabecalhoProcesso no MNI 2.2.2.
Superclasse dos papéis específicos de magistrado no PM4JUD, como o
pm4jud:RelatorHC.</rdfs:comment>
        <rdfs:label xml:lang="pt">Magistrado Atuante</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#MetaNacionalCNJ -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#MetaNacionalCNJ">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:comment xml:lang="pt">Variável dependente (d) do PM4JUD:
aderência às Metas CNJ 1, 2 e 4 (%). Subclasse de RegraJudicial;
verificada via constraints C7, C8 e C9 geradas pelo P5.</rdfs:comment>
        <rdfs:label xml:lang="pt">Meta Nacional CNJ</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#Paciente -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#Paciente">
        <rdfs:subClassOf rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#Parte"/>
        <rdfs:comment xml:lang="pt">Beneficiário da ordem de Habeas Corpus —
pessoa em cujo favor o writ é impetrado. Nos termos do art. 5º, inciso LXVIII,
da Constituição Federal.</rdfs:comment>
        <rdfs:label xml:lang="pt">Paciente</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#ProcessoCriminal -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#ProcessoCriminal">
        <rdfs:comment xml:lang="pt">Superclasse semântica PM4JUD para processos
de natureza criminal. Não corresponde a código TPU — é construção ontológica
do framework para agrupamento semântico.</rdfs:comment>
        <rdfs:label xml:lang="pt">Processo Criminal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RegraDeEspecializacao -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RegraDeEspecializacao">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <rdfs:comment xml:lang="pt">Restrição de atribuição de recurso
especializado. Verifica que o assessor (org:resource) possui
Assunto Processual compatível com a matéria do processo
(art. 110 RISTJ). Nível de verificação 2 — requer dados SAGWeb
ou eventos [SIM-ASSESSOR] do Complement (P3).</rdfs:comment>
        <rdfs:label xml:lang="pt">Regra de Especialização</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RegraDeExistencia -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RegraDeExistencia">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <rdfs:comment xml:lang="pt">Restrição de obrigatoriedade de
Movimentos Processuais no traço. Padrões Declare: existence,
absence, exactly1. Ex.: todo traço HC deve conter publicação
no DJe — TPU 92 ou 1061 (C6).</rdfs:comment>
        <rdfs:label xml:lang="pt">Regra de Existência</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RegraDeOrdem -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RegraDeOrdem">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <rdfs:comment xml:lang="pt">Restrição de sequência entre
Movimentos Processuais. Padrões Declare: precedence, response,
chain_response. Ex.: manifestação do MP antes da conclusão para
decisão (C2, art. 111 RISTJ).</rdfs:comment>
        <rdfs:label xml:lang="pt">Regra de Ordem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RegraDePrioridade -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RegraDePrioridade">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <rdfs:comment xml:lang="pt">Restrição que impõe julgamento
prioritário a determinadas Classes Processuais. Ex.: HC e RHC
independem de pauta (art. 91 e 202 RISTJ).</rdfs:comment>
        <rdfs:label xml:lang="pt">Regra de Prioridade</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RegraJudicial -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RegraJudicial">
        <rdfs:comment xml:lang="pt">Superclasse de todas as restrições
formalizadas no PM4JUD. Agrupa as regras regimentais do RISTJ
(RegraRegimental) e as Metas Nacionais do CNJ (MetaNacionalCNJ).
Os indivíduos desta classe são consultados via SPARQL em runtime
pelos programas P3, P5, P6 e P7. Atualizar os axiomas quando o
RISTJ ou as Metas CNJ forem alterados — o pipeline adapta-se sem
reescrita de código, habilitando o OE(e).</rdfs:comment>
        <rdfs:label xml:lang="en">Judicial Rule</rdfs:label>
        <rdfs:label xml:lang="pt">Regra Judicial</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RegraRegimental -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RegraRegimental">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#RegraJudicial"/>
        <rdfs:comment xml:lang="pt">Norma do RISTJ que condiciona a
tramitação processual. Formaliza constraints Declare no modelo DES
do PM4JUD. Subclasses: RegraDeOrdem, RegraTemporal,
RegraDeExistencia, RegraDeEspecializacao, RegraDePrioridade.</rdfs:comment>
        <rdfs:label xml:lang="pt">Regra Regimental</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RegraTemporal -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RegraTemporal">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#RegraRegimental"/>
        <rdfs:comment xml:lang="pt">Restrição de prazo máximo entre
dois eventos do traço. Padrão Declare: response com tempo_max.
Ex.: HC deve ser julgado em até 30 dias úteis após a conclusão
para decisão (C1, art. 91 RISTJ).</rdfs:comment>
        <rdfs:label xml:lang="pt">Regra Temporal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud#RelatorHC -->

    <owl:Class rdf:about="http://www.pucpr.br/pm4jud#RelatorHC">
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#MagistradoAtuante"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pucpr.br/pm4jud#vinculadoAOrgao"/>
                <owl:someValuesFrom rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#OrgaoJulgador"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="pt">Ministro relator designado para o processo
de Habeas Corpus. Vinculado ao mni:OrgaoJulgador do Módulo 1 (câmara ou turma
do STJ responsável pelo julgamento).</rdfs:comment>
        <rdfs:label xml:lang="pt">Relator de Habeas Corpus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.pucpr.br/pm4jud/classes#FamiliaHabeasCorpus -->

    <rdf:Description rdf:about="http://www.pucpr.br/pm4jud/classes#FamiliaHabeasCorpus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.pucpr.br/pm4jud#ProcessoCriminal"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.pucpr.br/pm4jud#temClasseProcessual"/>
                                <owl:hasValue rdf:resource="http://www.pucpr.br/pm4jud/classes#Classe_1013"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.pucpr.br/pm4jud#temClasseProcessual"/>
                                <owl:hasValue rdf:resource="http://www.pucpr.br/pm4jud/classes#Classe_1064"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.pucpr.br/pm4jud#temClasseProcessual"/>
                                <owl:hasValue rdf:resource="http://www.pucpr.br/pm4jud/classes#Classe_15224"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.pucpr.br/pm4jud#temClasseProcessual"/>
                                <owl:hasValue rdf:resource="http://www.pucpr.br/pm4jud/classes#Classe_1720"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.pucpr.br/pm4jud#temClasseProcessual"/>
                                <owl:hasValue rdf:resource="http://www.pucpr.br/pm4jud/classes#Classe_1722"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud#ProcessoCriminal"/>
    </rdf:Description>
    


    <!-- http://www.pucpr.br/pm4jud/classes#HabeasCorpus -->

    <rdf:Description rdf:about="http://www.pucpr.br/pm4jud/classes#HabeasCorpus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.pucpr.br/pm4jud#ProcessoCriminal"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.pucpr.br/pm4jud#temClasseProcessual"/>
                        <owl:hasValue rdf:resource="http://www.pucpr.br/pm4jud/classes#Classe_1720"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.pucpr.br/pm4jud/classes#FamiliaHabeasCorpus"/>
    </rdf:Description>
    


