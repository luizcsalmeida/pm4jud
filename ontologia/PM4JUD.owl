        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">Meta 2 CNJ 2025</rdfs:comment>
        <rdfs:label xml:lang="pt">C8 — Meta 2 CNJ: julgar processos distribuídos até 31/12/2020</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC9 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC9">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#MetaNacionalCNJ"/>
        <aplicaSeAAssuntoProcessual rdf:resource="http://www.pucpr.br/pm4jud/assuntos#GrupoCrimesAdministracaoPublica"/>
