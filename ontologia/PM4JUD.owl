        <rdfs:label xml:lang="pt">Previdenciário</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC1 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC1">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraTemporal"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_11383"/>
        <temAtividadeConsequente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_447"/>
        <codigoRegra>C1</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nivelVerificacao>
        <padraoLTLf>response</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 91, I do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>hard</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 91, caput, RISTJ</rdfs:comment>
        <rdfs:label xml:lang="pt">C1 — Prioridade HC: julgamento em até 30 dias úteis após conclusão</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC10 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC10">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraTemporal"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_51"/>
        <temAtividadeConsequente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_11383"/>
        <codigoRegra>C10</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nivelVerificacao>
        <padraoLTLf>response_with_deadline</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 110, I do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 110, I do RISTJ. Nível 1: verificável diretamente
no DATAJUD. TPU 51 (Conclusos para decisão) deve ser seguido de TPU 11383 (Ato ordinatório)
em até 10 dias úteis. Cobre tanto a via monocrática quanto a colegiada.</rdfs:comment>
        <rdfs:label xml:lang="pt">C10 — Ato ordinatório em até 10 dias após conclusos (art. 110, I)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC11 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC11">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraTemporal"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_51"/>
        <temAtividadeConsequente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_14093"/>
        <codigoRegra>C11</codigoRegra>
        <indicadorAlvo>T_bar</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nivelVerificacao>
        <padraoLTLf>response_with_deadline</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 110, III do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 110, III do RISTJ. Nível 1: verificável diretamente
no DATAJUD. TPU 51 (Conclusos) deve ser seguido de TPU 14093 (Voto do relator)
em até 30 dias úteis. Aplica-se exclusivamente à via colegiada.</rdfs:comment>
        <rdfs:label xml:lang="pt">C11 — Voto do relator em até 30 dias após conclusos (art. 110, III)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC12 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC12">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeOrdem"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_3002"/>
        <temAtividadeConsequente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_239"/>
        <codigoRegra>C12</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nivelVerificacao>
        <padraoLTLf>response</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 95 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>hard</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 95 do RISTJ. Nível 1: verificável diretamente
no DATAJUD. TPU 3002 (Inclusão em mesa para julgamento) deve ser seguido de TPU 239
(resultado do julgamento colegiado). Garante que o processo incluído em sessão é efetivamente
julgado na sessão designada.</rdfs:comment>
        <rdfs:label xml:lang="pt">C12 — Julgamento obrigatório após inclusão em mesa (art. 95)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC13 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC13">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraTemporal"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_3001"/>
        <temAtividadeConsequente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_11383"/>
        <codigoRegra>C13</codigoRegra>
        <indicadorAlvo>T_bar</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nivelVerificacao>
        <padraoLTLf>response_with_deadline</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 179 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 179 do RISTJ. Nível 1: verificável diretamente
no DATAJUD. TPU 3001 (Proclamação Final de Julgamento) deve ser seguido de TPU 11383
(Ato ordinatório — acórdão encaminhado à publicação) em até 30 dias. O 11383 aqui
sinaliza que a EMENTA/ACÓRDÃO já foi elaborada e enviada à publicação pelo gabinete.</rdfs:comment>
        <rdfs:label xml:lang="pt">C13 — EMENTA/ACÓRDÃO publicado em até 30 dias após proclamação (art. 179)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC14 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC14">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeExistencia"/>
        <codigoRegra>C14</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</nivelVerificacao>
        <padraoLTLf>precedence</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temAtividadeSAGWebAntecedente>Deslocamento: Gabinete para Turma</temAtividadeSAGWebAntecedente>
        <temAtividadeSAGWebConsequente>10: Criação de documento RELATÓRIO E VOTO</temAtividadeSAGWebConsequente>
        <temFundamentoNoArtigo>arts. 94 e 95 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>hard</tipoViolacao>
        <rdfs:comment xml:lang="pt">arts. 94 e 95 do RISTJ. Nível 2: requer log SAGWeb
(real na Fase 2 ou [SIM-ASSESSOR] na Fase 1). O deslocamento do processo ao órgão
julgador (Gabinete → Turma) pressupõe que o RELATÓRIO E VOTO já foi elaborado
pelo relator. Padrão: Precedence(criação RelVoto, deslocamento).</rdfs:comment>
        <rdfs:label xml:lang="pt">C14 — RELATÓRIO E VOTO precede deslocamento à Turma (arts. 94/95)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC15 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC15">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeExistencia"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_3001"/>
        <codigoRegra>C15</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</nivelVerificacao>
        <padraoLTLf>response</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temAtividadeSAGWebConsequente>10: Criação de documento EMENTA ACÓRDÃO</temAtividadeSAGWebConsequente>
        <temFundamentoNoArtigo>arts. 123, 178 e 180 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>hard</tipoViolacao>
        <rdfs:comment xml:lang="pt">arts. 123, 178 e 180 do RISTJ. Nível 2: requer log SAGWeb.
Após TPU 3001 (Proclamação Final de Julgamento), o gabinete do relator DEVE elaborar
e registrar no SAGWeb a EMENTA/ACÓRDÃO. Combina antecedente TPU (Nível 1) com
consequente SAGWeb (Nível 2) no log complementado pelo P3.</rdfs:comment>
        <rdfs:label xml:lang="pt">C15 — EMENTA/ACÓRDÃO obrigatório após proclamação (arts. 123/178/180)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC16 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC16">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeExistencia"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_51"/>
        <codigoRegra>C16</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</nivelVerificacao>
        <padraoLTLf>response</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temAtividadeSAGWebConsequente>10: Criação de documento DESPACHO DECISÃO</temAtividadeSAGWebConsequente>
        <temFundamentoNoArtigo>arts. 34, XVIII-XX e 38 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>hard</tipoViolacao>
        <rdfs:comment xml:lang="pt">arts. 34 (XVIII, XIX, XX), 38 (§1º, §2º) e 203, II do RISTJ.
Nível 2: requer log SAGWeb. Após TPU 51 (Conclusos para decisão), em traços sem TPU 3002
(não foram à sessão — via monocrática), o gabinete DEVE ter registrado a elaboração do
DESPACHO/DECISÃO no SAGWeb (atividade &quot;10: Criação de documento DESPACHO DECISÃO&quot;).
A ausência deste evento indica divergência entre o fluxo TPU e o fluxo interno do gabinete.</rdfs:comment>
        <rdfs:label xml:lang="pt">C16 — DESPACHO/DECISÃO obrigatório em traços monocráticos (arts. 34/38)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC2 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC2">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeOrdem"/>
        <codigoRegra>C2</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</nivelVerificacao>
        <padraoLTLf>precedence</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 111 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>hard</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 111, caput, RISTJ</rdfs:comment>
        <rdfs:label xml:lang="pt">C2 — MP manifesta em 2 dias antes da conclusão para decisão</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC3 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC3">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeEspecializacao"/>
        <codigoRegra>C3</codigoRegra>
        <indicadorAlvo>G</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</nivelVerificacao>
        <padraoLTLf>cond_resource</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 110 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 110, RISTJ</rdfs:comment>
        <rdfs:label xml:lang="pt">C3 — Assessor especializado na matéria do processo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC4 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC4">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeOrdem"/>
        <temAtividadeAntecedente rdf:resource="http://www.pucpr.br/pm4jud/movimentos#Movimento_14093"/>
        <codigoRegra>C4</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
        <nivelVerificacao rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</nivelVerificacao>
        <padraoLTLf>chain_response</padraoLTLf>
        <prazoMaxDiasUteis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</prazoMaxDiasUteis>
        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>art. 110 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 110, RISTJ</rdfs:comment>
        <rdfs:label xml:lang="pt">C4 — Preparação para assinatura precede o voto do relator</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC5 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC5">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#RegraDeOrdem"/>
        <codigoRegra>C5</codigoRegra>
        <indicadorAlvo>kappa</indicadorAlvo>
