        <temFundamentoNoArtigo>art. 110 do RISTJ</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">art. 110, RISTJ</rdfs:comment>
        <rdfs:label xml:lang="pt">C5 — Sem regressão de escaninho após Conclusão Para Decisão</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC6 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC6">
