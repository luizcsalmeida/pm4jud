        <rdfs:label xml:lang="pt">C6 — Todo traço com resultado HC deve ter publicação no DJe</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC7 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC7">
