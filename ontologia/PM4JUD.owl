        <regraAtiva rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</regraAtiva>
        <temFundamentoNoArtigo>Meta Nacional CNJ 1 — 2025</temFundamentoNoArtigo>
        <tipoViolacao>soft</tipoViolacao>
        <rdfs:comment xml:lang="pt">Meta 1 CNJ 2025</rdfs:comment>
        <rdfs:label xml:lang="pt">C7 — Meta 1 CNJ: julgar quantidade igual ou superior à distribuída</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud#RegraC8 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud#RegraC8">
        <rdf:type rdf:resource="http://www.pucpr.br/pm4jud#MetaNacionalCNJ"/>
