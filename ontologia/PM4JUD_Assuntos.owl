    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10950 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10950">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>61, II, h (CP); 2º (ECA); 1° a 29 (Lei 13.431/2017)</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10950</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Código Penal, Estatuto da Criança e do Adolescente e Lei 13.431/2017</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Assunto precipuamente complementar, para registro dos crimes/contravenções contra crianças ou adolescentes. Deve estar vinculado ao tipo penal objeto da ação penal. Somente deve ser usado nos casos de crimes ou contravenções contra crianças ou adolescentes fora do contexto de violência doméstica. Em casos de violência doméstica, deve-se usar o assunto complementar &quot;15174 - Violência Doméstica e Familiar contra Criança e Adolescente&quot;.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Crime / Contravenção contra Criança / Adolescente</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


