        <stj:dataAlteracaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-09-27T16:56:15</stj:dataAlteracaoAssunto>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
