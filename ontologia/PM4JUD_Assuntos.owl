        <stj:dispositivoLegalAssunto>L 10.251/2001</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Desapropriação com pagamento de indenização através de títulos públicos ou pagamento direto, por não cumprimento da obrigação de parcelamento, edificação ou utilização estabelecidas pelo Município (art. 5º, L 10.251/2001).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Desapropriação de Imóvel Urbano</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10135 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10135">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>5º, XXV</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10135</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CF1988</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Requisição é a retirada coercitiva e temporária de bens da posse de particulares, por autoridade competente, para elidir iminente perigo público. A requisição de bens não se confunde com a desapropriação, por ser temporária, não implicando a perda da propriedade.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Requisição de Bem Particular</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


