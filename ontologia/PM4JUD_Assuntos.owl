        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8.078/1990 (C.D.C.)</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Abrange as ações em que se busca a reparação de danos morais derivados de indevida inclusão em cadastros de inadimplentes. Artigo 6º, VI, e 43, do C.D.C.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Inclusão Indevida em Cadastro de Inadimplentes</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6233 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6233">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Artigo 54, do C.D.C.</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6233</stj:codigoAssuntoTPU>
        <stj:dataAlteracaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-04T16:37:47</stj:dataAlteracaoAssunto>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei n. 9.656/99 e Lei n. 8.078/90 (C.D.C.)</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Abrange as ações ajuizadas em face de Plano de Assistência Médica, Seguro Saúde e Sistemas de auto-gestão. Lei n. 9.656/99. Artigo 54, do C.D.C.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Planos de Saúde</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6238 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6238">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>24</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6238</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 5478/68</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 24. A parte responsável pelo sustento da família, e que deixar a residência comum por motivo, que não necessitará declarar, poderá tomar a iniciativa de comunicar ao juízo os rendimentos de que dispõe e de pedir a citação do credor, para comparecer à audiência de conciliação e julgamento destinada à fixação dos alimento a que está obrigado. (Lei 5478/68)</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Oferta</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6239 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6239">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>1694</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6239</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 10406/02</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 1.694. Podem os parentes, os cônjuges ou companheiros pedir uns aos outros os alimentos de que necessitem para viver de modo compatível com a sua condição social, inclusive para atender às necessidades de sua educação. (CC)</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Fixação</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


