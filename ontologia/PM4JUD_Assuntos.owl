        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>L 7.713/1988</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Pedidos de não-retenção ou restituição de IRPF indevidamente retido na fonte referentes a rendimentos do trabalho assalariado e outros rendimentos pagos por pessoas jurídicas, e rendimento real ou ganho de capital pago a beneficiário não identificado.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Retido na fonte</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_5923 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_5923">
