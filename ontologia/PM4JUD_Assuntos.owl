        <stj:glossarioAssunto>Questões que envolvam fiscalização, prevenção e segurança em edificações. ex.: Plano de combate a incendio.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Segurança em Edificações</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11841 -->

