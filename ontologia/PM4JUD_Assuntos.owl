    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9642 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9642">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>129, caput</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9642</stj:codigoAssuntoTPU>
