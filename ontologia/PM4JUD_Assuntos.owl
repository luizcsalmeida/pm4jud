        <stj:dispositivoLegalAssunto>Código Penal</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Capítulo II-B (DOS CRIMES EM LICITAÇÕES E CONTRATOS ADMINISTRATIVOS), do Título XI (DOS CRIMES CONTRA A ADMINISTRAÇÃO PÚBLICA), do Código Penal.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Crimes em Licitações e Contratos Administrativos</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15374 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15374">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>337-E</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15374</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-07-30T17:52:17</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Código Penal</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 337-E. Admitir, possibilitar ou dar causa à contratação direta fora das hipóteses previstas em lei: Pena - reclusão, de 4 (quatro) a 8 (oito) anos, e multa. Capítulo II-B (DOS CRIMES EM LICITAÇÕES E CONTRATOS ADMINISTRATIVOS), do Título XI (DOS CRIMES CONTRA A ADMINISTRAÇÃO PÚBLICA), do Código Penal.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Contratação Direta Ilegal</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15375 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15375">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
