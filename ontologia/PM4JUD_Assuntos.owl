        <stj:dispositivoLegalAssunto>CTN</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Processo visando à obtenção de certidões atestando a existência de créditos não vencidos, em curso de cobrança executiva em que tenha sido efetivada a penhora, ou cuja exigibilidade esteja suspensa.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Expedição de Certidão Positiva de Débito com Efeito de Negativa</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6002 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6002">
