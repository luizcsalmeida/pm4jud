    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14729 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14729">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>7º</stj:artigoLegalAssunto>
