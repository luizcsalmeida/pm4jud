        <stj:glossarioAssunto>Ações onde se pretende a utilização de índices diversos dos previstos na Lei 8.213/91 para a correção dos salários-de-contribuição por ocasião do cálculo da RMI do benefício.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Aplicação de coeficiente de cálculo diverso do fixado na Lei n.º 8.213/91</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6148 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6148">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
