        <stj:dispositivoLegalAssunto>CF</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Discussões sobre a aposentadoria compuslória aplicada como penalidade administrativa</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Aposentadoria Compulsória</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_12382 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_12382">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12382</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-13T00:00:00</stj:dataPublicacaoAssunto>
        <stj:glossarioAssunto>Conceito: É a reunião de dois ou mais partidos políticos, individualmente distintos, para formarem ou se transformarem em um só, desde que cumpridas todas as exigências de ordem legal instituídas para a formação dos partidos políticos.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Fusão de Partidos Políticos</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_12383 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_12383">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 4º</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12383</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-13T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>L. 13.715, de 2018</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Situações de determinação de perda do poder familiar em razão de condenação por crime de homicídio, feminicídio, lesão corporal grave ou seguida de morte no contexto de violência doméstica e familiar ou de discriminação de gênero ou contra a dignidade sexual contra titular do mesmo poder familiar ou descendente.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Perda por crime contra titular do mesmo poder ou descendente (L. 13.715/2018)</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


