        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>8.112/90</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Discussões sobre o conteúdo das questões de prova. Assunto usado também em relação a normas estaduais e municipais.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Anulação e Correção de Provas / Questões</stj:nomeAssuntoTPU>
