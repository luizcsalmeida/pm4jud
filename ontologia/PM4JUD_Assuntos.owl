        <stj:glossarioAssunto>Temas sobre o mês de competência da contribuição e outras controvérsias.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Prazo de Recolhimento</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6007 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6007">
