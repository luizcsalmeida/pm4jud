        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15624</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-09-02T18:35:03</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Código Penal e Estatuto da Criança e do Adolescente</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>CP Art. 171 - Obter, para si ou para outrem, vantagem ilícita, em prejuízo alheio, induzindo ou mantendo alguém em erro, mediante artifício, ardil ou qualquer outro meio fraudulento. ................................................................................ § 2º-A - A pena é de reclusão, de quatro a oito anos, e multa, se a fraude é cometida com uso de informações fornecidas pela vítima ou por terceiro induzido a erro por meio de redes sociais, contato telefônicos, e-mails fraudulentos ou outro. ECA Art. 103. Considera-se ato infracional a conduta descrita como crime ou contravenção penal.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Estelionato por Fraude Eletrônica (art. 171, § 2º-A)</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15628 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15628">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>166</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15628</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-09-02T19:01:39</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Código Civil</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Assunto a ser utilizado quando o desconto feito na folha de pagamento ou benefício previdenciário teve origem em pretensa associação ou adesão a associações civis ou sindicatos.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Desconto em Benefício Previdenciário de contribuição associativa ou sindical (ADPFs 1234 e 1236)</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15687 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15687">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>1º, III</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15687</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-01-28T13:33:19</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Resolução CNJ 599/2024</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Este assunto deve ser utilizado como assunto complementar ao tipo penal principal nos casos em que a vítima da conduta imputada foi a liderança ou a própria comunidade quilombola.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Crimes Praticados contra Lideranças e Comunidades Quilombolas</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15688 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15688">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>1º, III (Res. CNJ 599/2024); 103 (ECA)</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15688</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-01-28T13:39:25</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Resolução CNJ 599/2024 e ECA</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Este assunto deve ser utilizado como assunto complementar ao tipo penal  principal a que o ato infracional cometido é análogo nos casos em que a vítima da conduta imputada foi a liderança ou a própria comunidade quilombola.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Praticados contra Lideranças e Comunidades Quilombolas</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15692 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15692">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>9° (Decreto 11.072/2022); 2º, I (Res. CNJ 227/2016);</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15692</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-01-28T14:09:17</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Decreto 11.072/2022 e Resolução CNJ 227/2016</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Teletrabalho: Modalidade de trabalho em que as atividades são realizadas fora das dependências do órgão, de forma remota, com o uso de tecnologias de informação e comunicação. O teletrabalho pode ser total ou parcial.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Teletrabalho</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15720 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15720">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>10</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15720</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-08T14:28:53</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Resolução CNMP 310/2025</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Assunto complementar usado crimes ocorridos em decorrência ou no contexto de intervenções dos órgãos de segurança pública, quando houver suspeita de participação de agente estatal. Também deve ser habilitado para competências cíveis, para serem usados em registro de ações indenizatórias em razão de crimes desta natureza.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Crime Decorrente de Ações de Segurança Pública</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15722 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15722">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>156-A (CF); 1º, I (LC 214/2025)</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15722</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-09T12:52:27</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Constituição Federal e LC 214/2025</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Assunto a ser utilizado nos processos em que se discute algum aspecto dos critérios de incidência do Imposto sobre Bens e Serviços (IBS), criado pela Reforma Tributária (EC 132/2023 e LC 214/2025).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>IBS - Imposto sobre Bens e Serviços</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


