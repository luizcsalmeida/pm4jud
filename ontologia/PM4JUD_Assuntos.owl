        <stj:glossarioAssunto>Art. 185. Os benefícios do Plano de Seguridade Social do servidor compreendem: I - quanto ao servidor: f) licença por acidente em serviço.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Licença por Acidente em Serviço</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


