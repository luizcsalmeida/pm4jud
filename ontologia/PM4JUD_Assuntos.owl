        <stj:glossarioAssunto>Inclui os descontos promovidos diretamente pela Administração e os descontos consignados, como prêmios de seguros e parcelas de financiamento.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Descontos Indevidos</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10297 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10297">
