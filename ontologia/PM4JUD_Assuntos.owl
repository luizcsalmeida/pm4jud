    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10278 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10278">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 201, § 9º</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10278</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CF</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>§ 9º Para efeito de aposentadoria, é assegurada a contagem recíproca do tempo de contribuição na administração pública e na atividade privada, rural e urbana, hipótese em que os diversos regimes de previdência social se compensarão financeiramente, segundo critérios estabelecidos em lei. (Incluído dada pela Emenda Constitucional nº 20, de 1998)</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Averbação / Contagem Recíproca</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


