        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 24</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10514</stj:codigoAssuntoTPU>
        <stj:dataAlteracaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-29T11:32:32</stj:dataAlteracaoAssunto>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei nº 11.105/2005</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 24. Utilizar embrião humano em desacordo com o que dispõe o art. 5o desta Lei: Pena %u2013 detenção, de 1 (um) a 3 (três) anos, e multa.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Utilização de Embrião Humano em Desacordo com a Legislação - Biossegurança</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


