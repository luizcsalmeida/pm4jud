        <stj:dispositivoLegalAssunto>DL 3365/41</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Declara que a autoridade administrativa pode adentrar o imóvel para vistoriar e poder definir o valor de indenização.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Vistoria</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


