        <stj:dispositivoLegalAssunto>Código Civil</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Dano material decorrente do atraso injustificado na entrega de um bem imóvel decorrente de um contrato de Promessa de Compra e Venda</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Atraso na Entrega do Imóvel</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


