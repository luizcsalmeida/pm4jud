        <stj:artigoLegalAssunto>- arts. 955 a 965;</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7696</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei nº 10.406/02 (Código Civil)</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Conceito: Os títulos legais de preferência são os privilégios e os direitos reais</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Preferências e Privilégios Creditórios</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_7697 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_7697">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Súmula 54 do STJ</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7697</stj:codigoAssuntoTPU>
