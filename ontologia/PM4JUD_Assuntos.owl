    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14923 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14923">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14923</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-30T00:00:00</stj:dataPublicacaoAssunto>
        <stj:glossarioAssunto>É o procedimento de dividir os bens adquiridos durante o casamento, após a separação. Assim, ele acontece de acordo com o regime que o casal escolher. São eles: comunhão parcial de bens, comunhão total de bens, separação de bens ou participação final nos aquestos</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Partilha</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14924 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14924">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14924</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-30T00:00:00</stj:dataPublicacaoAssunto>
        <stj:glossarioAssunto>É o procedimento de dividir os bens adquiridos durante a união estável, após a separação.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Partilha</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14925 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14925">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>42, parágrafo único</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14925</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-30T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CDC</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>O consumidor cobrado em quantia indevida, terá direito à repetição do indébito, por valor igual ao dobro do que pagou em excesso, acrescido de correção monetária e juros legais, salvo hipótese de engano justificável, que deverá ser demonstrado pelo fornecedor a fim de afastar a sanção imposta no mencionado dispositivo legal</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Repetição do Indébito</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14926 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14926">
