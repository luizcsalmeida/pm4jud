        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-08-03T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CP</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 349-A.  Ingressar, promover, intermediar, auxiliar ou facilitar a entrada de aparelho telefônico de comunicação móvel, de rádio ou similar, sem autorização legal, em estabelecimento prisional. (Incluído pela Lei nº 12.012, de 2009).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Entrada de aparelho telefônico de comunicação móvel em estabelecimento prisional</stj:nomeAssuntoTPU>
