        <stj:glossarioAssunto>Classificar questões relativas aos contratos de crédito direto ao consumidor, em especial quanto ao regime, limitação e periodicidade de capitalização de juros.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Crédito Direto ao Consumidor - CDC</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14758 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14758">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
