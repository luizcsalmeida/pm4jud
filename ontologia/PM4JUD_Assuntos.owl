    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9767 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9767">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>242</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9767</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CP</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 242. Dar parto alheio como próprio; registrar como seu o filho de outrem; ocultar recém-nascido ou substituí-lo, suprimindo ou alterando direito inerente ao estado civil</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Parto Suposto (Art. 242)</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9768 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9768">
