        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Ccom</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Questões relativas à propriedade, gozo e especificações das embarcações.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Quanto à Embarcação</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_7798 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_7798">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>art. 8º, II, 10, IV</stj:artigoLegalAssunto>
