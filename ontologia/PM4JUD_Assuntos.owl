    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9901 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9901">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 58</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9901</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 6.001/73</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Artigo 58 - Constituem crimes contra os índios e a cultura indígena: I - escarnecer de cerimônia, rito, uso, costumes ou tradição culturais indígenas, vilipendiá-los ou perturbar, de qualquer modo, a sua prática. Pena - detenção de um a três meses; II - utilizar o índio ou comunidade indígena como objeto de propaganda turística ou de exibição para fins lucrativos. Pena - detenção de dois a seis meses; II - propiciar, por qualquer meio, a aquisição, o uso e a disseminação de bebidas alcoólicas, nos grupos tribais ou entre índios não integrados. Pena - detenção de seis meses a dois anos.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Praticados contra os índios e a cultura indígena</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9903 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9903">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 10</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9903</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 7.347/85</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Constitui crime, punido com pena de reclusão de 1 (um) a 3 (três) anos, mais multa de 10 (dez) a 1.000 (mil) Obrigações Reajustáveis do Tesouro Nacional - ORTN, a recusa, o retardamento ou a omissão de dados técnicos indispensáveis à propositura da ação civil, quando requisitados pelo Ministério Público.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Recusa, retardamento ou omissão de dados técnicos indispensáveis à propositura de Ação Civil Pública</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9904 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9904">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 19 e 20</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9904</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 4.947/69</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Artigo 19 - Utilizar, como prova de propriedade ou de direitos a ela relativos, documento expedido pelo IBRA para fins cadastrais ou tributários, em prejuízos de ontem ou em proveito próprio ou alheio. Artigo 20 - Invadir, com intenção de ocupá-las, terras da União, dos Estados e dos Municípios.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Agrários</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9905 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9905">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 4º</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9905</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 1.579/52</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 4º. Constitui crime:I - Impedir, ou tentar impedir, mediante violência, ameaça ou assuadas, o regular funcionamento de Comissão Parlamentar de Inquérito, ou o livre exercício das atribuições de qualquer dos seus membros. Pena - A do art. 329 do Código Penal. II - fazer afirmação falsa, ou negar ou calar a verdade como testemunha, perito, tradutor ou intérprete, perante a Comissão Parlamentar de Inquérito: Pena - A do art. 342 do Código Penal.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Relacionados à Comissão Parlamentar de Inquérito</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9906 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9906">
