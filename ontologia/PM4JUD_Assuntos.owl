     -->

    


    <!-- http://www.pucpr.br/pm4jud/assuntos#ehCrimeAdministracaoPublica -->

    <owl:AnnotationProperty rdf:about="http://www.pucpr.br/pm4jud/assuntos#ehCrimeAdministracaoPublica">
        <rdfs:comment xml:lang="pt">Marca os assuntos TPU/CNJ pertencentes ao grupo &apos;crimes contra
a administração pública&apos; (Título XI do CP, arts. 312-359-H): grupos 3547, 5872, 5873, 5874 e 5875
e todos os seus descendentes (66 nós). Usado pela constraint C9 (Meta 4a CNJ) do PM4JUD-LTLf (P6)
via pm4jud:aplicaSeAAssuntoProcessual em PM4JUD.owl (RegraC9).</rdfs:comment>
        <rdfs:label xml:lang="pt">Crimes contra a Administração Pública (Título XI do CP)</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:AnnotationProperty>
    


