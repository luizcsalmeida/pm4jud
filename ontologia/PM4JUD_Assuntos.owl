        <stj:dispositivoLegalAssunto>L. 13.718, de 2018</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Trata-se do ato infracional relacionado ao tipo disposto no artigo 215-A do Código Penal</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Importunação Sexual</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_12385 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_12385">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 2º</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12385</stj:codigoAssuntoTPU>
        <stj:dataAlteracaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-16T13:50:07</stj:dataAlteracaoAssunto>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-13T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 13.718/2018</stj:dispositivoLegalAssunto>
