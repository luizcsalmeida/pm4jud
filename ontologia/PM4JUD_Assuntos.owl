    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9877 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9877">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 19</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9877</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8.429-92</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 19. Constitui crime a representação por ato de improbidade contra agente público ou terceiro beneficiário quando o autor da denúncia o sabe inocente. Pena - detenção de 6 (seis) a 10 (dez) meses e multa. Parágrafo único. Além da sanção penal, o denunciante está sujeito a indenizar o denunciado pelos danos materiais, morais ou à imagem que houver provocado.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Representação caluniosa</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


