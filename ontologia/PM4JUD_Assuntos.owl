        <stj:dispositivoLegalAssunto>Lei n. 9.870/99</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Abrange as ações ajuizadas contra estabelecimentos de ensino. Lei n. 9.870/99.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Estabelecimentos de Ensino</stj:nomeAssuntoTPU>
