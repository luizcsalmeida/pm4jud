    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_7689 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_7689">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>299 a 303</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7689</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei nº 10.406/02 (Código Civil</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Conceito: Ato em que terceiro, com consenso do credor, se responsabiliza pelo débito do devedor, que, assim, se exonerará. (Dicionário Jurídico %u2013 Maria Helena Diniz)</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Assunção de Dívida</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


