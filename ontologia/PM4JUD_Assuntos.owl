    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_7785 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_7785">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>43</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7785</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>cp</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>caso da multa, a qual só pode ser aplicada em substituição a pena privativa de liberdade, quando esta não for superior a seis meses.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Prestação Pecuniária</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_7786 -->

