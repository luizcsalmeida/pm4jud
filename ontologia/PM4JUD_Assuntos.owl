        <stj:dispositivoLegalAssunto>Lei 7238/84</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Aplicação da data base para servidores estaduais, distritais e municipais. Para servidores federais aplica-se Revisão Geral Anual (Mora do Executivo - inciso X, art. 37, CF1988).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Data Base</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10301 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10301">
