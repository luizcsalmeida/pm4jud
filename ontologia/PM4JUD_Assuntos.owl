    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_5632 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_5632">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>arts. 189 a 211</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5632</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 10406/02</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>- Prescrição: É a extinção de uma pretensão ajuizável, em virtude da inércia de seu titular durante um certo lapso de tempo, na ausência de causas preclusivas de seu curso - Decadência: É a extinção do direito pela inação de seu titular que deixa escoar o prazo legal ou voluntariamente fixado para seu exercício</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Prescrição e Decadência</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


