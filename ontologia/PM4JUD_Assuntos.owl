    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_13219">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13219</stj:codigoAssuntoTPU>
