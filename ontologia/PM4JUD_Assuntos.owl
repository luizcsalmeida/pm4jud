        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-10-05T00:00:00</stj:dataPublicacaoAssunto>
        <stj:glossarioAssunto>Para temas relacionados ao parcelamento ilegal do solo que envolva as seguintes situações: conjuntos habitacionais, desdobro sucessivo, desmembramento, empreendimentos em terrenos de marinha, fraudes à lei nº 6.766/79, licenciamento em parcelamento de solo.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Parcelamento do Solo</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11837 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_11837">
