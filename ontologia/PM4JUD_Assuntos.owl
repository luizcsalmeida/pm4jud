        <stj:glossarioAssunto>Art. 81. Conceder-se-á ao servidor licença: III - para o serviço militar.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Serviço Militar</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10267 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10267">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>81 IV</stj:artigoLegalAssunto>
