    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10367 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10367">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>82, XI</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10367</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 6880 de 1980</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 82. O militar será agregado quando for afastado temporariamente do serviço ativo por motivo de: XI - ter sido condenado à pena de suspensão do exercício do posto, graduação, cargo ou função prevista no Código Penal Militar;</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Suspensão</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


