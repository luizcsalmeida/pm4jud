    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_15623 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_15623">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>171, § 2º-A</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15623</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-09-02T18:26:42</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Código Penal</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 171 - Obter, para si ou para outrem, vantagem ilícita, em prejuízo alheio, induzindo ou mantendo alguém em erro, mediante artifício, ardil ou qualquer outro meio fraudulento. ................................................................................ § 2º-A - A pena é de reclusão, de quatro a oito anos, e multa, se a fraude é cometida com uso de informações fornecidas pela vítima ou por terceiro induzido a erro por meio de redes sociais, contato telefônicos, e-mails fraudulentos ou outro meio similar.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Estelionato por Fraude Eletrônica</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


