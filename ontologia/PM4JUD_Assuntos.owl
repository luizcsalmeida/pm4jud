        <stj:dispositivoLegalAssunto>CF</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>O ingresso na carreira de juiz e membro do Ministério Público tem como requisito essencial o prévio exercício de 03 (três) anos de atividade jurídica.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Exigência de Prática Forense</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


