        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5952</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CF 1988; CTN; Sum 589 STF; Sum 668 STF; Sum 724 STF; Sum 166 STJ.</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Discussões a respeito da incidência sobre a propriedade a posse ou o domínio útil predial e territorial urbanos, a progressividade de sua alíquota ou a imunidade recíproca em bens imóveis alugados a terceiros.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>IPTU/ Imposto Predial e Territorial Urbano</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


