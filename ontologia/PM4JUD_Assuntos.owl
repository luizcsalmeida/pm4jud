    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10122 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10122">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>art. 1º, 2º, 5º</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10122</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>DL 3365/41</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Desapropriação em que o Estado, para atender situações normais, tem de adquirir o domínio e o uso de bens de outrem.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Desapropriação por Utilidade Pública / DL 3.365/1941</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10123 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10123">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>art. 1º e segs.</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10123</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 4132/62</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Desapropriação em que o Estado, para impor um melhor aproveitamento da terra rural ou para prestigiar certas camadas sociais, adquire a propriedade de alguém e a trespassa a terceiro.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Desapropriação por Interesse Social Comum / L 4.132/1962</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


