        <stj:glossarioAssunto>Discussões acerca da cobrança de correção monetária. Ver também Resp 862.346/2007, que estabeleceu precedente sobre correção monetária em danos morais.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Correção Monetária</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_7698 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_7698">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>arts. 402 a 405</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7698</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei nº 10.406/02 (Código Civil)</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Conceito: Perdas e danos constituem o equivalente do prejuízo ou dano suportado pelo credor, em virtude do devedor não ter cumprido, total ou parcialmente, absoluta ou relativamente, a obrigação, expressando-se numa soma em dinheiro correspondente ao desequilíbrio sofrido pelo lesado. (Curso de Direito Civil Brasileiro %u2013 Maria Helena Diniz)</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Perdas e Danos</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


