        <stj:glossarioAssunto>Ações onde se discute a metodologia aplicada pelo INSS para conversão dos benefícios em URV em 1º de março de 1994.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Sistemática de conversão dos benefícios previdenciários em URVs</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6150 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6150">
