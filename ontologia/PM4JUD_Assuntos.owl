        <stj:glossarioAssunto>Questões discutindo incidência de ITR sobre a propriedade a posse ou o domínio útil territorial rural.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>ITR/ Imposto Territorial Rural</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


