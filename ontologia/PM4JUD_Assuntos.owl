        <stj:dataAlteracaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-09-27T16:53:34</stj:dataAlteracaoAssunto>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CF</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Assunto específico relacionado com danos provocados nna prestação de serviços de saúde, que suprime a necessidade de classificar em Dano Moral e/ou Material e/ou Estético e/ou Funcional.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Serviços de Saúde</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


