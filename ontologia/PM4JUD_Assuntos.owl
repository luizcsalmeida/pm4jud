        <stj:glossarioAssunto>Abrange os serviços de coleta, tratamento e abastecimento de águas; acondicionamento, coleta, transporte e destino final dos resíduos sólidos; coleta de águas pluviais e controle de empoçamentos e inundações.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Saneamento</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11863 -->

