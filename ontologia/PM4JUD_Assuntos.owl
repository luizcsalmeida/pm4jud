        <stj:dispositivoLegalAssunto>MP 1.415/96</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Casos onde se pretende a revisão do reajustamento da renda mensal do benefício em maio de 1996, segundo a variação do INPC no percentual de 18,34%. Discute-se a inaplicabilidade da utilização do IGP-DI nesse período.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Reajustamento pelo INPC</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6151 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6151">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>art. 144</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6151</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8.213/91</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Ações onde se pretende a revisão da RMI dos benefícios iniciados entre 05/10/88 e 05/04/91 (chamado período do Buraco Negro). Discussões: 1. termo inicial dos efeitos financeiros de tal revisão (junho/92); 2. os benefícios iniciados a partir de 05/04/91 devem ser revisados na forma do art. 145.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Art. 144 da Lei 8.213/91 e/ou diferenças decorrentes</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6152 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6152">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
