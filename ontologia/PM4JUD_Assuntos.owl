        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-10-05T00:00:00</stj:dataPublicacaoAssunto>
        <stj:glossarioAssunto>A ser utilizado em questões relativas à Comercialização de produtos em áreas não regulamentadas. Exemplo: camelô.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Comércio Ambulante</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11838 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_11838">
