        <stj:glossarioAssunto>Questões relativas ao conjunto de leis municipais que trata das posturas dos cidadãos em relação aos espaços comuns da cidade. Execetuando-se o comércio ambulante já previsto em item específico.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Posturas Municipais</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11840 -->

