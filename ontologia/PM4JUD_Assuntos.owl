        <stj:glossarioAssunto>Questões relativas à violação às normas de finanças públicas e responsabilidades na gestão fiscal de entes públicos. Lei Complementar nº 101/2000.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Responsabilidade Fiscal</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11864 -->

