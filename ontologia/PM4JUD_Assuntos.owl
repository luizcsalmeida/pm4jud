        <stj:glossarioAssunto>Discussões sobre o imposto sobre transmissão de quaisquer bens e direitos por causa da morte (sucessão, inventário, arrolamento), ou por doação (transmissão gratuita).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>ITCD - Imposto de Transmissão Causa Mortis</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_5956 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_5956">
