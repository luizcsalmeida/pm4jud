        <stj:nomeAssuntoTPU>IPVA - Imposto Sobre Propriedade de Veículos Automotores</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_5954 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_5954">
