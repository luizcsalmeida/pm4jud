        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-12T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>LC 35</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Discussões acerca da aplicação da penalidade administrativa de remoção compulsória de magistrados</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Remoção Compulsória</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


