        <stj:dispositivoLegalAssunto>Lei 6.538/78</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Processos relativos a crimes contra o serviço postal e de telegrama.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Contra o Serviço Postal e o Serviço de Telegrama</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


