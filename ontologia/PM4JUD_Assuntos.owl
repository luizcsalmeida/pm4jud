        <stj:glossarioAssunto>Irregularidades no Atendimento: Questões relacionadas à precariedade no atendimento, nelas se incluindo tempo de espera na fila, melhoria de serviço de call center, implementação de postos de atendimento avançado.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Irregularidade no atendimento</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11865 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_11865">
