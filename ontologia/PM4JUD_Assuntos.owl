        <stj:dispositivoLegalAssunto>Resolução/CJF nº 267, de 02.12.2013</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Classificar recursos em que se discute o cálculo da correção monetária conforme estabelece o Manual de Cálculos da Justiça Federal.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Incidência do Manual de Cálculos da Justiça Federal</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14861 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14861">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14861</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-29T00:00:00</stj:dataPublicacaoAssunto>
        <stj:glossarioAssunto>Discussão no sentido de que não constitui ofensa aos institutos da coisa julgada e da preclusão a inclusão dos expurgos inflacionários no cálculo da correção monetária, em conta de liquidação de sentença, ainda que a questão não tenha sido debatida no processo de conhecimento.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Inclusão de Expurgos Inflacionários</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


