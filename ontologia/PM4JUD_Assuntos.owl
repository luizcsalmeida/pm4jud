        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6153</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8213/91; Lei 8178/91</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Causas que versam sobre os abonos de que trata a Lei n.º 8.178/91, por força do art. 146 da Lei n.º 8.213/91, que foram incorporados aos benefícios de prestação continuada apenas em 1º de setembro de 1991, sem retroação.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Abono da Lei 8.178/91</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


