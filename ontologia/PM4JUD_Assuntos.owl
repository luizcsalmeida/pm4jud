        <stj:artigoLegalAssunto>Arts. 19 a 27</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9869</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 6.453/77</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Discussões acerca da responsabilidade criminal em decorrência de danos nuclueares.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Responsabilidade Criminal por Danos Nucleares</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9870 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9870">
