        <stj:glossarioAssunto>Discussões sobre direitos assegurados na Lei no 10.741/2003 (Estatuto do Idoso).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Pessoa Idosa</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11843 -->

