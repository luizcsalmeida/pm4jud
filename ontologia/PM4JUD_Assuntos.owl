        <stj:glossarioAssunto>Diz respeito a questões de crédito agrícola, subsídios, estoques reguladores, assistência técnica e extensão rural, seguro agrícola, eletrificação rural e cooperativas.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Política Agrícola</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


