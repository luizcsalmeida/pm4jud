        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2014-05-28T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei n. 11.101/2005</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Assunto para registro de processos referentes a busca pelo pronunciamento judicial da extinção das obrigações do falido, após o encerramento do processo de falência.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Extinção das Obrigaões do Falido</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11986 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_11986">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
