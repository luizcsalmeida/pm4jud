        <stj:glossarioAssunto>Discussões sobre o reconhecimento da imunidade tributária, que é a vedação do tributo pela Constituição, que não se enquadrem nas imunidades especificadas na tabela.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Imunidade</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


