        <stj:dispositivoLegalAssunto>CTN</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Processo visando obtenção de certidões atestando a quitação de débitos tributários.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Expedição de CND</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6001 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6001">
