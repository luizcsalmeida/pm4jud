        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10295</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8112/90; Lei 9624/98</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Trata de todas as formas de incorporação de gratificações por exercício de funções, como os conhecidos quintos ou décimos do RJU da União.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Gratificação Incorporada / Quintos e Décimos / VPNI</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10296 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10296">
