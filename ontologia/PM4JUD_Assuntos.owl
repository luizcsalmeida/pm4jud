        <stj:dispositivoLegalAssunto>CTN</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Demandas a respeito da condição de responsável pelo pagamento do tributo (crédito tributário), ou responsabilidade de sucessores (por sucessão) ou de terceiros ou responsável solidário (solidadriedade), ou exclusividade (responsabilidade pessoal) ou subsidiariedade.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Responsabilidade tributária</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_5980 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_5980">
