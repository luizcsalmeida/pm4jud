        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CF 1988 ; CTN</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Discussões sobre base de cálculo ou alíquota desproporcional desarrazoada ou confiscatória das taxas, ou sobre a divisibilidade ou espicificidade da taxa ou efetividade do serviço ou fiscalização.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Taxas</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_5957 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_5957">
