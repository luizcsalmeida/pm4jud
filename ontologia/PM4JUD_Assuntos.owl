        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-10-05T00:00:00</stj:dataPublicacaoAssunto>
        <stj:glossarioAssunto>Inclui concessão do prêmio, da agência lotérica, licença para sorteio público, autorização e regularidade de promoções comerciais que envolvam distribuição gratuita de prêmios a título de propaganda (Lei 5768/71).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Jogos / Sorteios / Promoções comerciais</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


