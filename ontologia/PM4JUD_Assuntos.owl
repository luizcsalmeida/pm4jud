        <stj:glossarioAssunto>Temas relacionados às medidas coordenadas pelo município, com a participação de proprietários e moradores, a fim de se alcançar em uma área melhorias sociais, valorização ambiental e transformações urbanísticas estruturais.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Operações Urbanas Consorciadas</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11839 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_11839">
