        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei nº 10.406/02 (Código Civil)</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Conceito: Juros legais são aqueles cuja a taxa é fixada em lei ou os devidos por força de lei. (Dicionário Jurídico %u2013 Maria Helena Diniz) o Limite dos juros está contemplado no art. 406 do CC.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Limitação de Juros</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10587 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10587">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
