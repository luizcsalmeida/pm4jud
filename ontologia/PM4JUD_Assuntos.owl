    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10373 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10373">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>art. 5º, V</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10373</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8112/90</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>É requisito essencial para investidura em cargo público a idade minima de 18 anos. Aplica-se, também, às ações em que se discute limite máximo de idade para ingresso no serviço público, para determinados cargos.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Limite de Idade</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10374 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10374">
