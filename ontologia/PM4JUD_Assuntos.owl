        <stj:glossarioAssunto>Não confunde com retrocessão. Neste caso a iniciativa é do Poder Público, que desiste da finalidade da desapropriação.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Restituição de área</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


