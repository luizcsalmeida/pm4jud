    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_12031 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_12031">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>13</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12031</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2014-07-16T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Dec. 4887/2003</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 13.  Incidindo nos territórios ocupados por remanescentes das comunidades dos quilombos título de domínio particular não invalidado por nulidade, prescrição ou comisso, e nem tornado ineficaz por outros fundamentos, será realizada vistoria e avaliação do imóvel, objetivando a adoção dos atos necessários à sua desapropriação, quando couber.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Desapropriação para Regularização de Comunidade Quilombola / Dec. 4887/2003</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


