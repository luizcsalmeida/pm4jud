        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-30T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>CDC</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Utilizar nos processos que pretendem revisar juros de contratos bancários regidos pelo CDC.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Revisão de Juros Remuneratórios, Capitalização/Anatocismo</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


