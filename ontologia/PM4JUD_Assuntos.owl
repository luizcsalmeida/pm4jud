        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6004</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 6830/80</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Para classificar ações ordinária, declaratória, mandados de segurança ou outras que visem anular o débito fiscal, com base em nulidade no procedimento fiscal ou em relação à matéria. É assunto subsidiário e visa também, medir a quantidade destas ações.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Anulação de Débito Fiscal</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


