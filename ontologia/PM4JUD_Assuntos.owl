        <stj:dispositivoLegalAssunto>CP</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 246. Deixar, sem justa causa, de prover à instrução primária de filho em idade escola</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Abandono Intelectual</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9759 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9759">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
