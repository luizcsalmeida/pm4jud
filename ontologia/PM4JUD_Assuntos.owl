        <stj:glossarioAssunto>Também considerado crime hediondo (Lei 8072/90, art. 1º, parágrafo único).</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>De genocídio</stj:nomeAssuntoTPU>
