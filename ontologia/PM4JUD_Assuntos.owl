<rdf:RDF xmlns="http://www.pucpr.br/pm4jud/assuntos#"
     xml:base="http://www.pucpr.br/pm4jud/assuntos"
     xmlns:mni="http://www.cnj.jus.br/intercomunicacao-2.2.2#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
