    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_9912 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_9912">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Arts. 136 a 408</stj:artigoLegalAssunto>
