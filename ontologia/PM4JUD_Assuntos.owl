        <stj:glossarioAssunto>Prática comercial que consiste em vender determinado produto ou serviço somente se o consumidor adquirir outro produto ou serviço da mesma empresa.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Vendas casadas</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11866 -->

