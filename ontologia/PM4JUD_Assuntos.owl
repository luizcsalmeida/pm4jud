        <stj:glossarioAssunto>Questões relacionadas às pessoas com necessidades especiais contempladas na Lei 7853/89 e Lei 10098/00.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Pessoas com deficiência</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_11844 -->

