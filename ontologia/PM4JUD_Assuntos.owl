    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14142 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14142">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>1 ao 4</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14142</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>MP 2.131/2000, Lei 8.237/1991</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Classificar processos em que se discutem reflexos inconstitucionais da MP que, ao determinar a exclusão do adicional de inatividade do soldo dos militares, substituindo-o pelo adicional de permanência, teria incidido em inconstitucionalidade e em ofensa ao direito adquirido, em que pese a inocorrência de redução de valor nominal das parcelas percebidas.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Adicional de Inatividade</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14143 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14143">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>Art. 4/Decreto (Revogado pela MP 2.215/2001)</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14143</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8.237/1991, Decreto 4.307/2002</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>A Gratificação de Compensação Orgânica é destinada a compensar os desgastes orgânicos consequentes das variações de altitude, das variações barométricas e da exposição a radiações resultantes do desempenho continuado das atividades especiais, em especial o desempenho de trabalho com Raio-X ou substancias radioativas.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Gratificação de Compensação Orgânica</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14144 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14144">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>34 e 38 (Lei 8.237/1991)</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14144</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-18T00:00:00</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8.237/1991 e Leis Estaduais que tratam de ajuda de custo a militares estaduais</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Permite a classificação de feitos de militar da ativa transferindo por interesse do serviço, com mudança de sede, o qual tem direito à indenização pelas despesas de transporte, incluindo passagens, bagagens, para si, seus dependentes e um empregado doméstico, da localidade onde residir para outa, onde fixara residência, quando o transporte não for realizado pela União.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Ajuda de Custo</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_14145 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_14145">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
