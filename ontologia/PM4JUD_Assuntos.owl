        <stj:glossarioAssunto>Inclui as diárias, indenização de transporte, auxílio-moradia, e outras indenizações que houver.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Diárias e Outras Indenizações</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10299 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10299">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
