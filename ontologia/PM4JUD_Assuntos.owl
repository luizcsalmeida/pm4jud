        <stj:dispositivoLegalAssunto>Lei 8213/91; MP 1.415/96</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Ações onde se pretende a revisão do benefício em junho de 1997, junho de 1998, junho de 1999, junho de 2000, junho de 2001 e junho de 2002 com base na variação acumulada do IGP-DI.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Reajustamento pelo IGP-DI</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_6147 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_6147">
