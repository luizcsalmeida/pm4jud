        <stj:dispositivoLegalAssunto>CP</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Art. 245. Entregar filho menor de dezoito anos a pessoa em cuja companhia saiba ou deva saber que o menor fica moral ou materialmente em perigo.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Entrega de Filho Menor a Pessoa Inidônea</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


