        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei nº 5.315/67</stj:dispositivoLegalAssunto>
        <stj:nomeAssuntoTPU>Ex-combatentes</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


