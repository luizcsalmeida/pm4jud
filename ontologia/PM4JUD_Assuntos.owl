    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_10380 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_10380">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>art. 5º, IV</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10380</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 8112/90</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Deve ser observado o nível de escolaridade exigido para cada cargo. Utilizado também em relação a normas estaduais, municipais e editalícias.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Escolaridade</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


