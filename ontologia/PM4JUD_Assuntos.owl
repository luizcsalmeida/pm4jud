    <!-- http://www.pucpr.br/pm4jud/assuntos#Assunto_7687 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/assuntos#Assunto_7687">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#AssuntoProcessual"/>
        <stj:artigoLegalAssunto>1796 (CC), 983 (CPC) e 1o (Lei 6858)</stj:artigoLegalAssunto>
        <stj:codigoAssuntoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7687</stj:codigoAssuntoTPU>
        <stj:dataPublicacaoAssunto rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-30T15:52:52</stj:dataPublicacaoAssunto>
        <stj:dispositivoLegalAssunto>Lei 10406/02, Lei 5869/73 e Lei 6858/80</stj:dispositivoLegalAssunto>
        <stj:glossarioAssunto>Abrange as ações de inventário e partilha, arrolamentos, alvarás objetivando recebimento de valores que independem de inventário e sobrepartilhas. Carregamento automático nas classes de inventário e partilha e arrolamento.</stj:glossarioAssunto>
        <stj:nomeAssuntoTPU>Inventário e Partilha</stj:nomeAssuntoTPU>
    </owl:NamedIndividual>
    


