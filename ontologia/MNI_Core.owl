                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="pt">Posição da parte no processo conforme modalidadePoloProcessual do MNI 2.2.2.</rdfs:comment>
        <rdfs:label xml:lang="pt">Tipo de Polo Processual</rdfs:label>
    </owl:Class>
    


