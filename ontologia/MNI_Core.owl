            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="pt">Representante processual de uma parte (advogado, MP, Defensoria etc.).
Corresponde ao complexType tipoRepresentanteProcessual do MNI 2.2.2.
Modalidade obrigatória: A | E | M | D | P.</rdfs:comment>
        <rdfs:label xml:lang="pt">Representante Processual</rdfs:label>
    </owl:Class>
    


