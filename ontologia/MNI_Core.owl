Corresponde ao complexType tipoProcessoJudicial do MNI 2.2.2.</rdfs:comment>
        <rdfs:label xml:lang="pt">Processo Judicial</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cnj.jus.br/intercomunicacao-2.2.2#QualificacaoPessoa -->

    <owl:Class rdf:about="http://www.cnj.jus.br/intercomunicacao-2.2.2#QualificacaoPessoa">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cnj.jus.br/intercomunicacao-2.2.2#QualificacaoPessoaAutoridade"/>
                    <rdf:Description rdf:about="http://www.cnj.jus.br/intercomunicacao-2.2.2#QualificacaoPessoaFisica"/>
                    <rdf:Description rdf:about="http://www.cnj.jus.br/intercomunicacao-2.2.2#QualificacaoPessoaJuridica"/>
                    <rdf:Description rdf:about="http://www.cnj.jus.br/intercomunicacao-2.2.2#QualificacaoPessoaOrgaoRepresentacao"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="pt">Tipo de qualificação da pessoa no processo.
Alinhado ao simpleType tipoQualificacaoPessoa do MNI 2.2.2:
  fisica | juridica | autoridade | orgaorepresentacao.</rdfs:comment>
        <rdfs:label xml:lang="pt">Qualificação de Pessoa</rdfs:label>
    </owl:Class>
    


