Corresponde ao complexType tipoPoloProcessual do MNI 2.2.2.</rdfs:comment>
        <rdfs:label xml:lang="pt">Polo Processual</rdfs:label>
    </owl:Class>
    


    <!-- http://www.cnj.jus.br/intercomunicacao-2.2.2#ProcessoJudicial -->

