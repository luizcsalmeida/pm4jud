    <!-- http://www.pucpr.br/pm4jud/documentos#Documento_15700 -->

    <owl:NamedIndividual rdf:about="http://www.pucpr.br/pm4jud/documentos#Documento_15700">
        <rdf:type rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2#Documento"/>
        <stj:codigoDocumentoTPU rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15700</stj:codigoDocumentoTPU>
