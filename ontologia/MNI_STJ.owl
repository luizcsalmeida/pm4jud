        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Código único do tipo de documento processual conforme TPU/CNJ.</rdfs:comment>
        <rdfs:label xml:lang="pt">código do documento TPU</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#codigoMovimentoTPU -->

