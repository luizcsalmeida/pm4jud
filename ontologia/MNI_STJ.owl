    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#apenso -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#apenso">
        <rdfs:domain rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#DocumentoStj"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="pt">Indica se o documento é um apenso ao processo principal.</rdfs:comment>
        <rdfs:label xml:lang="pt">apenso</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#artigoLegalAssunto -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#artigoLegalAssunto">
