        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Código único da classe processual conforme Tabela Processual Unificada do CNJ.
Domain omitido intencionalmente para permitir reuso em PM4JUD_Classes.owl.</rdfs:comment>
        <rdfs:label xml:lang="pt">código da classe TPU</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#codigoClasseTribunalOrigem -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#codigoClasseTribunalOrigem">
