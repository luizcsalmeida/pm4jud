        <rdfs:label xml:lang="pt">artigo legal do movimento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#codigoAssuntoTPU -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#codigoAssuntoTPU">
