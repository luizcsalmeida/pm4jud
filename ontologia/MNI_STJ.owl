    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#dataAlteracaoDocumento -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#dataAlteracaoDocumento">
