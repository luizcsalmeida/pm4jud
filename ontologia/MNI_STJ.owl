<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.stj.jus.br/mni/intercomunicacao#"
     xml:base="http://www.stj.jus.br/mni/intercomunicacao"
     xmlns:mni="http://www.cnj.jus.br/intercomunicacao-2.2.2#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:stj="http://www.stj.jus.br/mni/intercomunicacao#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.stj.jus.br/mni/intercomunicacao">
        <owl:imports rdf:resource="http://www.cnj.jus.br/intercomunicacao-2.2.2"/>
        <rdfs:comment xml:lang="pt">Extensão específica do Superior Tribunal de Justiça (STJ) para o
Modelo Nacional de Interoperabilidade do CNJ versão 2.2.2.

Este módulo é parte da Framework PM4JUD — Process Mining Framework for Judicial Decision-Making
Framework de mineração de processos para dados judiciais brasileiros, desenvolvido na PUCPR como adaptação
do framework PM4SOS (Ferronato, 2022) para o contexto do Superior Tribunal de Justiça (STJ).

COMPONENTES INTEGRADOS:
• Modelo Nacional de Interoperabilidade (MNI) do CNJ
• Tabelas Processuais Unificadas (TPU) do CNJ
  - Classes Processuais (140 classes em hierarquia)
  - Assuntos Processuais (futuro)
  - Movimentos Processuais (futuro)
  - Tipos de Documentos (futuro)
• Ontologia de Atividades de Gabinetes (futuro)
• Integração com Event Logs XES

INSTITUIÇÃO: PUCPR - Pontifícia Universidade Católica do Paraná
PESQUISADOR:
  • Luiz Claudio Soares de Almeida (Mestrando)
ORIENTADOR: Prof. Edson Emílio Scalabrin
PERÍODO: 2024-2026</rdfs:comment>
        <rdfs:label xml:lang="pt">MNI-STJ - Extensão STJ do Modelo Nacional de Interoperabilidade</rdfs:label>
        <rdfs:label xml:lang="en">MNI-STJ - STJ Extension of the National Interoperability Model</rdfs:label>
        <owl:versionInfo>2.2.2</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#TipoVisibilidade -->

    <rdfs:Datatype rdf:about="http://www.stj.jus.br/mni/intercomunicacao#TipoVisibilidade">
        <rdfs:comment xml:lang="pt">Datatype restrito aos valores &quot;Sim&quot; ou &quot;Não&quot;.
Usado na propriedade stj:visibilidadeExterna dos movimentos processuais TPU.</rdfs:comment>
        <rdfs:label xml:lang="pt">Tipo Visibilidade (Sim/Não)</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>Sim|Não</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#temClasseProcessual -->

    <owl:ObjectProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#temClasseProcessual">
        <rdfs:domain rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#CabecalhoProcessoStj"/>
        <rdfs:range rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#ClasseProcessual"/>
        <rdfs:comment xml:lang="pt">Relaciona o cabeçalho STJ com sua classe processual TPU.</rdfs:comment>
        <rdfs:label xml:lang="pt">tem classe processual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#temDetalheNaturezaFisico -->

    <owl:ObjectProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#temDetalheNaturezaFisico">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#CabecalhoProcessoStj"/>
        <rdfs:range rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#DetalheProcessoFisico"/>
        <rdfs:comment xml:lang="pt">Relaciona o cabeçalho STJ com os detalhes de processo físico.
Aplicável apenas quando stj:temNaturezaEnvio = stj:NaturezaFisico.</rdfs:comment>
        <rdfs:label xml:lang="pt">tem detalhe de processo físico</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#temNaturezaEnvio -->

    <owl:ObjectProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#temNaturezaEnvio">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#CabecalhoProcessoStj"/>
        <rdfs:range rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#NaturezaEnvio"/>
        <rdfs:comment xml:lang="pt">Indica a forma de envio do processo ao STJ:
ELETRONICO | DIGITALIZADO | FISICO.</rdfs:comment>
        <rdfs:label xml:lang="pt">tem natureza de envio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#temRepresentativoControversia -->

    <owl:ObjectProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#temRepresentativoControversia">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#CabecalhoProcessoStj"/>
        <rdfs:range rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#RepresentativoControversia"/>
        <rdfs:comment xml:lang="pt">Indica se o processo é representativo de controvérsia (recurso repetitivo).</rdfs:comment>
        <rdfs:label xml:lang="pt">tem representativo de controvérsia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#temUnidadeFederacao -->

    <owl:ObjectProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#temUnidadeFederacao"/>
    


