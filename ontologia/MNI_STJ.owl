        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="pt">Indica se o processo tramita em matéria criminal.</rdfs:comment>
        <rdfs:label xml:lang="pt">criminal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#custas -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#custas">
        <rdfs:domain rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#CabecalhoProcessoStj"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="pt">Indica o status de recolhimento das custas processuais.</rdfs:comment>
        <rdfs:label xml:lang="pt">custas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#dataAlteracaoAssunto -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#dataAlteracaoAssunto">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="pt">Data da última alteração do assunto na TPU.</rdfs:comment>
        <rdfs:label xml:lang="pt">data de alteração do assunto</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#dataAlteracaoClasse -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#dataAlteracaoClasse">
