    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoAssunto -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoAssunto">
