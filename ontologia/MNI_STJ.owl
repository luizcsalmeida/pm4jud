        <rdfs:comment xml:lang="pt">Data de publicação oficial da classe na Tabela Processual Unificada.</rdfs:comment>
        <rdfs:label xml:lang="pt">data de publicação da classe</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoDocumento -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoDocumento">
