        <rdfs:label xml:lang="pt">data de publicação do assunto</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoClasse -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoClasse">
