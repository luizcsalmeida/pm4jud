        <rdfs:comment xml:lang="pt">Artigo específico da lei que trata do assunto.</rdfs:comment>
        <rdfs:label xml:lang="pt">artigo legal do assunto</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#artigoLegalClasse -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#artigoLegalClasse">
