        <rdfs:label xml:lang="pt">data de publicação do documento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoMovimento -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#dataPublicacaoMovimento">
