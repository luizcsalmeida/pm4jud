        <rdfs:label xml:lang="pt">complemento do movimento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#criminal -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#criminal">
