        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Código único do assunto processual conforme TPU/CNJ.</rdfs:comment>
        <rdfs:label xml:lang="pt">código do assunto TPU</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#codigoClassePrimeiraInstancia -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#codigoClassePrimeiraInstancia">
        <rdfs:domain rdf:resource="http://www.stj.jus.br/mni/intercomunicacao#ClasseProcessual"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Código da classe processual na primeira instância conforme TPU/CNJ.</rdfs:comment>
        <rdfs:label xml:lang="pt">código da classe da primeira instância</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#codigoClasseTPU -->

    <owl:DatatypeProperty rdf:about="http://www.stj.jus.br/mni/intercomunicacao#codigoClasseTPU">
