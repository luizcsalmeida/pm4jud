        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Código da classe processual no tribunal de origem conforme TPU/CNJ.</rdfs:comment>
        <rdfs:label xml:lang="pt">código da classe do tribunal de origem</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.stj.jus.br/mni/intercomunicacao#codigoDocumentoTPU -->

